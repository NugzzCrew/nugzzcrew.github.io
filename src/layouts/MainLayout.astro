---
interface Props {
  title: string;
}

const { title } = Astro.props;
import '../styles/global.css';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHomePage = path === '/' || path === '/index.html';

// Use your verified Channel ID with the join trigger
const channelJoinUrl = "https://www.youtube.com/channel/UCYNmnbEgm3G0m4avmwz_4Eg/join?v=dummy";

// Updated to use your local PNG files located in public/images/
const socials = [
  { name: 'YouTube', url: channelJoinUrl, img: 'YouTube Logo.png' },
  { name: 'Twitch', url: 'https://www.twitch.tv/officialnugzzcrew', img: 'Twitch Logo.png' }, 
  { name: 'Kick', url: 'https://kick.com/officialnugzzcrew', img: 'Kick Logo.png' }, 
  { name: 'Discord', url: 'https://discord.gg/officialnugzzcrew', img: 'Discord Logo.png' },
  { name: 'TikTok', url: 'https://www.tiktok.com/@officialnugzzcrew', img: 'TikTok Logo.png' }, 
  { name: 'Instagram', url: 'https://www.instagram.com/officialnugzzcrew', img: 'IG Logo.png' },
  { name: 'X', url: 'https://x.com/NugzzCrew', img: 'X Logo.png' }, 
  { name: 'Facebook', url: 'https://www.facebook.com/nugzzcrew', img: 'FB Logo.png' },
  { name: 'Snapchat', url: 'https://www.snapchat.com/add/nugzzcrew', img: 'SnapChat Logo.png' },
  { name: 'Suno', url: 'https://suno.com/@officialnugzzcrew', img: 'Suno Logo.png' },
  { name: 'Shop', url: 'https://officialnugzzcrew-shop.fourthwall.com', img: 'FourthWall Logo.png' },
  { name: 'Crew', url: 'https://socialclub.rockstargames.com/crew/official_nugzz_crew', img: 'Rockstar Logo.png' },
];
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <title>{title} | Official Nugzz Crew</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
        <link rel="icon" type="image/png" href="/Logo.png" />
        <script src="https://unpkg.com/lucide@latest"></script>
    </head>
    <body class="bg-black text-white antialiased">
        <nav id="site-header" class="sticky top-0 z-50 bg-black/95 backdrop-blur-md border-b border-zinc-800 px-3 py-3 md:px-4">
            <div class="header-row max-w-7xl mx-auto flex items-center gap-3">
                <button
                    id="menu-toggle"
                    type="button"
                    aria-label="Open menu"
                    aria-expanded="false"
                    class="nav-burger items-center justify-center w-11 h-11 text-zinc-300 hover:text-gold shrink-0"
                >
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>

                <a href="/" class="brand-link flex items-center gap-2 group transition-opacity hover:opacity-90 min-w-0">
                    <img src="/Logo.png" alt="Logo" class="w-7 h-7 md:w-9 md:h-9 object-contain shrink-0" />
                    <span class="brand-mark font-header uppercase tracking-tighter whitespace-nowrap">
                        <span class="text-white">Official</span> <span class="text-gold">Nugzz Crew</span>
                    </span>
                </a>

                <div class="nav-desktop flex-1 justify-center gap-4 text-[9px] md:text-xs uppercase font-bold tracking-widest text-zinc-400">
                    {!isHomePage && <a href="/" class="hover:text-gold transition-colors">Home</a>}
                    <a href="/gta" class="hover:text-gold transition-colors">GTA Bonuses</a>
                    <a href="/generator" class="hover:text-gold transition-colors">DMO Gen</a>
                    <a href="/gtaresources" class="hover:text-gold transition-colors">GTA Resources</a>
                    <a href="/emblem" class="hover:text-gold transition-colors">Emblem Creator</a>
                    <a href="/media-kit" class="bg-gold text-black px-3 py-1.5 rounded-md hover:bg-yellow-400 transition-colors font-black">Media Kit</a>
                </div>
            </div>
        </nav>

        <div id="nav-overlay" class="fixed inset-0 bg-black/60 z-40 hidden"></div>
        <aside
            id="nav-menu"
            class="fixed top-0 left-0 h-full w-80 max-w-[90vw] bg-black/98 border-r border-zinc-800 z-50 -translate-x-full transition-transform duration-300 ease-in-out overflow-y-auto"
            aria-hidden="true"
        >
            <div id="menu-header" class="flex items-center justify-between px-5 border-b border-zinc-800 min-h-[72px]">
                <span class="font-header text-gold text-base uppercase tracking-wider">Menu</span>
                <button id="menu-close" type="button" aria-label="Close menu" class="text-zinc-400 hover:text-gold">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <div class="flex flex-col p-5 gap-2">
                {!isHomePage && <a href="/" class="nav-link px-5 py-4 rounded-lg text-zinc-300 hover:text-gold hover:bg-zinc-900/70 uppercase tracking-widest text-base font-bold">Home</a>}
                <a href="/gta" class="nav-link px-5 py-4 rounded-lg text-zinc-300 hover:text-gold hover:bg-zinc-900/70 uppercase tracking-widest text-base font-bold">GTA Bonuses</a>
                <a href="/generator" class="nav-link px-5 py-4 rounded-lg text-zinc-300 hover:text-gold hover:bg-zinc-900/70 uppercase tracking-widest text-base font-bold">DMO Gen</a>
                <a href="/gtaresources" class="nav-link px-5 py-4 rounded-lg text-zinc-300 hover:text-gold hover:bg-zinc-900/70 uppercase tracking-widest text-base font-bold">GTA Resources</a>
                <a href="/emblem" class="nav-link px-5 py-4 rounded-lg text-zinc-300 hover:text-gold hover:bg-zinc-900/70 uppercase tracking-widest text-base font-bold">Emblem Creator</a>
                <a href="/media-kit" class="nav-link px-5 py-4 rounded-lg bg-gold text-black hover:bg-yellow-400 uppercase tracking-widest text-base font-bold">Media Kit</a>
            </div>
        </aside>
        
        <main id="main-content" class="relative z-10">
            <slot /> 
        </main>

        {!isHomePage && (
            <div class="text-center py-8">
                <a href="/" class="inline-block px-6 py-3 bg-zinc-900 border border-zinc-700 rounded-lg text-gold hover:border-gold hover:bg-zinc-800 transition-all uppercase tracking-widest text-sm font-bold">
                    &larr; Back To Home
                </a>
            </div>
        )}

        <footer class="p-10 text-center text-zinc-600 text-[10px] uppercase tracking-widest border-t border-zinc-900 mt-20">
            <div class="flex justify-center flex-wrap gap-3 md:gap-4 mb-4">
                {socials.map((social) => (
                    <a href={social.url} target="_blank" rel="noopener noreferrer" class="group transition-opacity hover:opacity-100" title={social.name}>
                        <div class="w-5 h-5 md:w-6 md:h-6 flex items-center justify-center">
                            <img src={`/images/${social.img}`} alt={`${social.name} Logo`} class="w-full h-full object-contain opacity-70 group-hover:opacity-100 transition-opacity" />
                        </div>
                    </a>
                ))}
            </div>
            &copy; 2026 Official Nugzz Crew | Built for The Fam Bam
        </footer>

        <script is:inline>
          function initIcons() { if (window.lucide) window.lucide.createIcons(); }
          window.addEventListener('load', initIcons);
          document.addEventListener('astro:page-load', initIcons);

          function initMenu() {
            const toggle = document.getElementById('menu-toggle');
            const closeBtn = document.getElementById('menu-close');
            const menu = document.getElementById('nav-menu');
            const overlay = document.getElementById('nav-overlay');
            if (!toggle || !menu || !overlay || toggle.dataset.bound) return;
            toggle.dataset.bound = '1';

            function openMenu() {
              menu.classList.remove('-translate-x-full');
              menu.setAttribute('aria-hidden', 'false');
              overlay.classList.remove('hidden');
              toggle.setAttribute('aria-expanded', 'true');
              document.body.style.overflow = 'hidden';
            }

            function closeMenu() {
              menu.classList.add('-translate-x-full');
              menu.setAttribute('aria-hidden', 'true');
              overlay.classList.add('hidden');
              toggle.setAttribute('aria-expanded', 'false');
              document.body.style.overflow = '';
            }

            toggle.addEventListener('click', openMenu);
            closeBtn?.addEventListener('click', closeMenu);
            overlay.addEventListener('click', closeMenu);
            document.querySelectorAll('.nav-link').forEach((link) => link.addEventListener('click', closeMenu));
            document.addEventListener('keydown', (e) => {
              if (e.key === 'Escape') closeMenu();
            });
          }

          window.addEventListener('load', initMenu);
          document.addEventListener('astro:page-load', initMenu);
        </script>
    </body>
</html>

<style is:global>
    *, *::before, *::after {
        box-sizing: border-box;
    }

    html, body {
        max-width: 100%;
        overflow-x: clip;
    }

    body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        overflow-x: clip; 

        /* ---FIXED BACKGROUND PATH ---*/
        background-image: url('/Texture-LS_Map-Black.png');
        background-repeat: repeat;
        background-size: 2048px 2048px;
        background-attachment: fixed;
    }

    #video-container,
    #main-content :is(.rounded-2xl, .rounded-3xl, .rounded-\[2\.5rem\]) {
        box-shadow: 0 0 50px -12px rgba(212, 175, 55, 0.35);
    }
    #main-content :is(.rounded-2xl, .rounded-3xl, .rounded-\[2\.5rem\]) :is(.rounded-xl, .rounded-2xl, .rounded-3xl, .rounded-\[2\.5rem\]) {
        box-shadow: none;
    }

    .page-shell {
        width: 100%;
        max-width: 80rem;
        margin-inline: auto;
        padding: 3rem 1.5rem 1rem;
    }

    .page-title {
        margin: 0;
        text-align: left;
        font-weight: 900;
        font-style: italic;
        text-transform: uppercase;
        letter-spacing: -0.04em;
        line-height: 0.85;
        font-size: clamp(36px, 6vw, 64px);
    }

    .page-kicker {
        margin: 0.85rem 0 0;
        text-align: left;
        color: #a1a1aa;
        font-weight: 700;
        font-size: 0.75rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
    }

    .page-head {
        margin: 0 0 2.5rem;
    }

    .van-map {
        transform: scale(1);
        transition: transform 0.7s ease, opacity 0.5s ease;
    }
    .group:hover .van-map {
        transform: scale(2);
    }

    .glow-red:hover {
        border-color: #ef4444 !important;
        box-shadow: 0 0 42px -6px rgba(239, 68, 68, 0.8) !important;
    }
    .glow-purple:hover {
        border-color: #c084fc !important;
        box-shadow: 0 0 42px -6px rgba(192, 132, 252, 0.8) !important;
    }
    .glow-blue:hover {
        border-color: #60a5fa !important;
        box-shadow: 0 0 42px -6px rgba(96, 165, 250, 0.8) !important;
    }

    #video-container.is-theater {
        position: fixed !important;
        inset: 0 !important;
        z-index: 9990 !important;
        width: 100% !important;
        height: 100% !important;
        max-width: none !important;
        margin: 0 !important;
        border: 0 !important;
        border-radius: 0 !important;
        aspect-ratio: auto !important;
        box-shadow: none !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        background: #000 !important;
    }
    #video-container.is-theater #offline-placeholder {
        position: relative !important;
        width: auto !important;
        height: auto !important;
        max-width: min(1100px, 94vw) !important;
        max-height: 86dvh !important;
        object-fit: contain !important;
    }
    #video-container.is-theater #yt-video-frame {
        position: relative !important;
        width: min(96vw, calc(86dvh * 16 / 9)) !important;
        height: min(86dvh, calc(96vw * 9 / 16)) !important;
    }
    #video-container.is-theater #theater-btn {
        position: absolute !important;
        top: 16px !important;
        right: 16px !important;
        bottom: auto !important;
    }

    @media (max-width: 768px) {
        body { background-attachment: scroll; }
    }

    .nav-burger { display: flex; }
    .nav-desktop { display: none; }
    @media (min-width: 1100px) {
        .nav-burger { display: none; }
        .nav-desktop { display: flex; }
    }

    @media (max-width: 1099px) {
        .header-row {
            position: relative;
            justify-content: center;
            min-height: 2.75rem;
        }
        .nav-burger {
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
        }
        .brand-link {
            max-width: calc(100% - 6.5rem);
        }
    }

    .brand-mark {
        font-size: clamp(14px, 1.15vw, 18px) !important;
    }
    @media (max-width: 1099px) {
        .brand-mark {
            font-size: clamp(14px, 4.4vw, 19px) !important;
        }
    }

    .text-gold-bright {
        color: #D4AF37;
        text-shadow: 0 0 10px rgba(212, 175, 55, 0.2);
    }
</style>