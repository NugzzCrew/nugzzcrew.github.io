---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Thank You">
  <div class="page-shell">
    <header class="page-head">
      <h1 class="page-title">
        <span class="text-white">Message</span>
        <span class="text-gold">Sent</span>
      </h1>
      <p class="page-kicker">Thanks for reaching out</p>
    </header>

    <div class="flex justify-center">
      <div class="nugzz-card p-6 md:p-8 max-w-xl w-full text-center">
        <p class="text-zinc-300 text-lg mb-6">
          Your message has been received. We’ll get back to you as soon as
          possible.
        </p>
        <a
          href="/"
          class="inline-block px-6 py-3 bg-zinc-900 border border-zinc-700 rounded-lg text-gold hover:border-gold hover:bg-zinc-800 transition-all uppercase tracking-widest text-sm font-bold"
        >
          &larr; Back to Home
        </a>
      </div>
    </div>
  </div>
</MainLayout>
