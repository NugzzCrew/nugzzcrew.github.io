---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Home">
  <section class="page-shell">
    <header class="page-head">
      <h1 class="page-title">
        <span class="text-white">Nobody</span> <span class="text-gold">Does It Better!</span>
      </h1>
      <p class="page-kicker">
        Streaming, GTA Updates, and the best community in the world.
      </p>
    </header>

    <!-- Current Working Videos Showcase -->
    <div class="mb-10">
      <h2 class="font-header text-gold uppercase tracking-wide text-xl mb-4 text-center">Current Working Videos</h2>
      <p class="text-center text-zinc-400 text-sm mb-6">Featured playlists from the Official Nugzz Crew YouTube home page.</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Money Glitches -->
        <div class="nugzz-card">
          <h3 class="font-header text-gold uppercase tracking-wide text-lg mb-3">Money Glitches</h3>
          <div class="aspect-video rounded-lg overflow-hidden border border-zinc-800">
            <iframe
              class="w-full h-full"
              src="https://www.youtube.com/embed/videoseries?list=PLs8voOllOroX0PQZ2Hk70k57OeiZS0wtH"
              title="Money Glitches Playlist"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
          <a href="https://www.youtube.com/playlist?list=PLs8voOllOroX0PQZ2Hk70k57OeiZS0wtH" target="_blank" rel="noopener" class="mt-3 inline-block text-gold hover:text-gold-bright text-sm uppercase tracking-widest">Watch Full Playlist →</a>
        </div>

        <!-- DMO / Save Editor -->
        <div class="nugzz-card">
          <h3 class="font-header text-gold uppercase tracking-wide text-lg mb-3">DMO / Save Editor Methods</h3>
          <div class="aspect-video rounded-lg overflow-hidden border border-zinc-800">
            <iframe
              class="w-full h-full"
              src="https://www.youtube.com/embed/videoseries?list=PLs8voOllOroVRP6PfVAMkT-18BQIAO_Nv"
              title="DMO Methods Playlist"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
          <a href="https://www.youtube.com/playlist?list=PLs8voOllOroVRP6PfVAMkT-18BQIAO_Nv" target="_blank" rel="noopener" class="mt-3 inline-block text-gold hover:text-gold-bright text-sm uppercase tracking-widest">Watch Full Playlist →</a>
        </div>

        <!-- GCTF / GC2F -->
        <div class="nugzz-card">
          <h3 class="font-header text-gold uppercase tracking-wide text-lg mb-3">GCTF / GC2F Methods</h3>
          <div class="aspect-video rounded-lg overflow-hidden border border-zinc-800">
            <iframe
              class="w-full h-full"
              src="https://www.youtube.com/embed/videoseries?list=PLs8voOllOroXXjw8T41POLAClqPDnyvhh"
              title="GCTF Methods Playlist"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
          <a href="https://www.youtube.com/playlist?list=PLs8voOllOroXXjw8T41POLAClqPDnyvhh" target="_blank" rel="noopener" class="mt-3 inline-block text-gold hover:text-gold-bright text-sm uppercase tracking-widest">Watch Full Playlist →</a>
        </div>

        <!-- Merge Methods -->
        <div class="nugzz-card">
          <h3 class="font-header text-gold uppercase tracking-wide text-lg mb-3">Merge Methods</h3>
          <div class="aspect-video rounded-lg overflow-hidden border border-zinc-800">
            <iframe
              class="w-full h-full"
              src="https://www.youtube.com/embed/videoseries?list=PLs8voOllOroXOkToRkfZEhGrSjNzrouYs"
              title="Merge Methods Playlist"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
          <a href="https://www.youtube.com/playlist?list=PLs8voOllOroXOkToRkfZEhGrSjNzrouYs" target="_blank" rel="noopener" class="mt-3 inline-block text-gold hover:text-gold-bright text-sm uppercase tracking-widest">Watch Full Playlist →</a>
        </div>
      </div>
    </div>

    <div class="text-center mt-8">
      <a href="/crew-controls" class="inline-block bg-zinc-900/60 border border-zinc-700 hover:border-gold text-gold hover:text-gold-bright uppercase tracking-widest text-sm font-bold px-6 py-3 rounded-xl transition-colors">
        Go to Crew Controls (Live Stream + Commands)
      </a>
    </div>
  </section>
</MainLayout>
