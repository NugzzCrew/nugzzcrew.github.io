                  <script is:inline>
                    let ws;

                    function connectBot() {
                      ws = new WebSocket("wss://wss.officialnugzzcrew.com/");

                      ws.onopen = () => {
                        ws.send(
                          JSON.stringify({
                            request: "Subscribe",
                            events: { general: ["Custom"] },
                            id: "SubRequest",
                          }),
                        );
                        setTimeout(() => {
                          ws.send(
                            JSON.stringify({
                              request: "DoAction",
                              action: { name: "Web_Request_Status" },
                              id: "StatusCheck",
                            }),
                          );
                          // Force evaluation of Discord button right after WS connection
                          updateStreamState(currentLiveVideoId !== null);
                        }, 1000);
                      };

                      ws.onmessage = (event) => {
                        try {
                          const msg = JSON.parse(event.data);
                          if (
                            msg.data &&
                            msg.data.data &&
                            msg.data.data.name === "LiveStatusUpdate"
                          ) {
                            const data = msg.data.data;
                            handleLiveStatus(data);
                            updateStreamState(data.isLive);
                          }
                        } catch (e) {
                          console.log("Parsing error:", e);
                        }
                      };

                      ws.onclose = () => {
                        const el = document.getElementById("status-msg");
                        if (el)
                          el.textContent =
                            "Offline: Streamer's PC not reachable.";
                        updateStreamState(false);
                        setTimeout(connectBot, 5000);
                      };
                    }

                    const OWNER_CHANNEL_ID = "UCYNmnbEgm3G0m4avmwz_4Eg";
                    let ownerForceEnable = false;
                    let ownerOverrideVideoId = null;
                    let currentLiveVideoId = null;

                    function handleLiveStatus(data) {
                      const videoFrame =
                        document.getElementById("yt-video-frame");
                      const placeholder = document.getElementById(
                        "offline-placeholder",
                      );
                      const chatFrame =
                        document.getElementById("yt-chat-frame");
                      const chatFrameMobile = document.getElementById(
                        "yt-chat-frame-mobile",
                      );
                      const chatWrapper =
                        document.getElementById("chat-wrapper");
                      const chatWrapperMobile = document.getElementById(
                        "chat-wrapper-mobile",
                      );
                      const videoCol = document.getElementById("video-col");
                      const commands =
                        document.getElementById("commands-container");

                      const incomingId = (data.videoId || "").trim();

                      if (ownerOverrideVideoId) {
                        updateStreamState(data.isLive === true);
                        return;
                      }

                      if (
                        incomingId !== "" &&
                        currentLiveVideoId === incomingId
                      ) {
                        updateStreamState(data.isLive === true);
                        return;
                      }

                      const isLive = data.isLive === true && incomingId !== "";

                      if (isLive) {
                        currentLiveVideoId = incomingId;
                        if (videoFrame) {
                          videoFrame.style.display = "block";
                          videoFrame.src = `https://www.youtube.com/embed/${incomingId}?autoplay=1&mute=1`;
                        }
                        if (placeholder) placeholder.style.display = "none";

                        const chatSrc = `https://www.youtube.com/live_chat?v=${incomingId}&embed_domain=${location.hostname}&dark_theme=1`;
                        if (chatFrame) chatFrame.src = chatSrc;
                        if (chatFrameMobile) chatFrameMobile.src = chatSrc;

                        if (chatWrapper) chatWrapper.classList.remove("hidden");
                        if (chatWrapperMobile)
                          chatWrapperMobile.classList.remove("hidden");

                        if (videoCol) {
                          videoCol.classList.remove("max-w-4xl", "mx-auto");
                          videoCol.classList.add("flex-1", "min-w-0");
                        }
                        if (commands) {
                          commands.classList.remove("max-w-4xl");
                          commands.classList.add("max-w-6xl");
                        }
                      } else {
                        currentLiveVideoId = null;
                        if (videoFrame) {
                          videoFrame.style.display = "none";
                          videoFrame.src = "about:blank";
                        }
                        if (placeholder) placeholder.style.display = "block";

                        if (chatWrapper) chatWrapper.classList.add("hidden");
                        if (chatWrapperMobile)
                          chatWrapperMobile.classList.add("hidden");

                        if (videoCol) {
                          videoCol.classList.add("max-w-4xl", "mx-auto");
                          videoCol.classList.remove("flex-1", "min-w-0");
                        }
                        if (commands) {
                          commands.classList.add("max-w-4xl");
                          commands.classList.remove("max-w-6xl");
                        }
                      }
                    }

                    function applyOwnerVideoOverride(videoId) {
                      const videoFrame =
                        document.getElementById("yt-video-frame");
                      const chatFrame =
                        document.getElementById("yt-chat-frame");
                      const chatFrameMobile = document.getElementById(
                        "yt-chat-frame-mobile",
                      );
                      const placeholder = document.getElementById(
                        "offline-placeholder",
                      );
                      const chatWrapper =
                        document.getElementById("chat-wrapper");
                      const chatWrapperMobile = document.getElementById(
                        "chat-wrapper-mobile",
                      );

                      currentLiveVideoId = videoId;
                      if (videoFrame) {
                        videoFrame.style.display = "block";
                        videoFrame.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&mute=1`;
                      }
                      if (placeholder) placeholder.style.display = "none";
                      const chatSrc = `https://www.youtube.com/live_chat?v=${videoId}&embed_domain=${location.hostname}&dark_theme=1`;
                      if (chatFrame) chatFrame.src = chatSrc;
                      if (chatFrameMobile) chatFrameMobile.src = chatSrc;
                      if (chatWrapper) chatWrapper.classList.remove("hidden");
                      if (chatWrapperMobile)
                        chatWrapperMobile.classList.remove("hidden");
                    }

                    function clearOwnerVideoOverride() {
                      ownerOverrideVideoId = null;
                      currentLiveVideoId = null;
                      const videoFrame =
                        document.getElementById("yt-video-frame");
                      const chatFrame =
                        document.getElementById("yt-chat-frame");
                      const chatFrameMobile = document.getElementById(
                        "yt-chat-frame-mobile",
                      );
                      const placeholder = document.getElementById(
                        "offline-placeholder",
                      );
                      const chatWrapper =
                        document.getElementById("chat-wrapper");
                      const chatWrapperMobile = document.getElementById(
                        "chat-wrapper-mobile",
                      );

                      if (videoFrame) {
                        videoFrame.style.display = "none";
                        videoFrame.src = "about:blank";
                      }
                      if (chatFrame) chatFrame.src = "about:blank";
                      if (chatFrameMobile) chatFrameMobile.src = "about:blank";
                      if (chatWrapper) chatWrapper.classList.add("hidden");
                      if (chatWrapperMobile)
                        chatWrapperMobile.classList.add("hidden");
                      if (placeholder) placeholder.style.display = "block";
                      const input = document.getElementById("owner-video-id");
                      if (input) input.value = "";
                    }

                    function updateStreamState(live) {
                      const msgEl = document.getElementById("status-msg");
                      const buttons = document.querySelectorAll(".stream-cmd");
                      const linkDiscordBtn =
                        document.getElementById("link-discord-btn");
                      const user = JSON.parse(
                        localStorage.getItem("nugzzUser") || "null",
                      );
                      const isOwner =
                        user && user.youtubeId === OWNER_CHANNEL_ID;
                      const debugTools =
                        document.getElementById("owner-debug-tools");
                      const isConnected =
                        ws && ws.readyState === WebSocket.OPEN;

                      if (debugTools) {
                        debugTools.classList.toggle("hidden", !isOwner);
                      }

                      // Link Discord is active whenever connected to bot, regardless of live stream status or user auth status
                      if (linkDiscordBtn) {
                        linkDiscordBtn.disabled = !isConnected;
                      }

                      if (!msgEl) return;

                      const allowCommands =
                        isConnected &&
                        user &&
                        (live || (isOwner && ownerForceEnable));

                      if (allowCommands) {
                        buttons.forEach((btn) => (btn.disabled = false));
                        if (isOwner && !live && ownerForceEnable) {
                          msgEl.textContent = ownerOverrideVideoId
                            ? "Owner Debug — Custom video loaded + commands enabled."
                            : "Bot Connected (Owner Force-Enable). Commands enabled for preview.";
                          msgEl.style.color = "#4ade80";
                        } else if (live) {
                          msgEl.textContent = "Bot Connected (Stream Online)";
                          msgEl.style.color = "#4ade80";
                        } else {
                          msgEl.textContent = "Bot Connected (Stream Offline)";
                          msgEl.style.color = "#a1a1aa";
                        }
                      } else {
                        buttons.forEach((btn) => (btn.disabled = true));
                        if (!user) {
                          msgEl.textContent = "Sign in to trigger commands.";
                        } else if (!isConnected) {
                          msgEl.textContent = "Connecting to Streamer.bot...";
                        } else {
                          msgEl.textContent = "Bot Connected (Stream Offline)";
                        }
                        msgEl.style.color = "#a1a1aa";
                      }
                    }

                    function handleLinkDiscord() {
                      if (!ws || ws.readyState !== WebSocket.OPEN) {
                        alert("Not connected to Streamer.bot.");
                        return;
                      }

                      const user = JSON.parse(
                        localStorage.getItem("nugzzUser") || "null",
                      );

                      // Check if both YouTube and Discord are available in local storage
                      if (
                        !user ||
                        !user.youtubeId ||
                        !user.discord ||
                        !user.discord.id
                      ) {
                        const authPrompt = confirm(
                          "You need to be signed in to YouTube and have Discord linked to proceed. Click OK to log in/authorize.",
                        );
                        if (authPrompt) {
                          // Adjust this route to match your actual authentication flow
                          window.location.href = "/login";
                        }
                        return;
                      }

                      const payload = {
                        request: "DoAction",
                        action: { name: "Link Discord From Website" },
                        args: {
                          youtubeName: user.name || "",
                          youtubeId: user.youtubeId || "",
                          userProfileUrl: user.picture || "",
                          discordName: user.discord.username || "",
                          discordId: user.discord.id || "",
                        },
                        id: "WebLinkDiscord",
                      };

                      ws.send(JSON.stringify(payload));
                      alert("Discord link sent to Streamer.bot!");
                    }

                    let cooldownTimer = null;
                    let cooldownRemaining = 0;

                    function setButtonsDisabled(disabled) {
                      document
                        .querySelectorAll(".stream-cmd")
                        .forEach((btn) => {
                          btn.disabled = disabled;
                        });
                    }

                    function startCooldown() {
                      if (cooldownTimer) clearInterval(cooldownTimer);
                      cooldownRemaining = 15;
                      setButtonsDisabled(true);
                      const msgEl = document.getElementById("status-msg");
                      const original = msgEl ? msgEl.textContent : "";
                      cooldownTimer = setInterval(() => {
                        cooldownRemaining--;
                        if (msgEl)
                          msgEl.textContent = `Cooldown: ${cooldownRemaining}s`;
                        if (cooldownRemaining <= 0) {
                          clearInterval(cooldownTimer);
                          cooldownTimer = null;
                          setButtonsDisabled(false);
                          if (msgEl)
                            msgEl.textContent =
                              original || "Bot Connected (Stream Online)";
                        }
                      }, 1000);
                    }

                    function sendAction(actionName, extraCommand = null) {
                      const user = JSON.parse(
                        localStorage.getItem("nugzzUser") || "null",
                      );
                      if (!ws || ws.readyState !== WebSocket.OPEN) {
                        alert("Not connected to Live Hub.");
                        return;
                      }
                      if (!user) {
                        alert("Please sign in to use commands.");
                        return;
                      }
                      if (cooldownRemaining > 0) return;

                      const displayName = user.name || "";
                      const payload = {
                        request: "DoAction",
                        action: { name: actionName },
                        args: {
                          isWebsocketRequest: "True",
                          userId: user.youtubeId,
                          user: displayName,
                          userName: displayName,
                          displayName: displayName,
                          userProfileUrl: user.picture || "",
                          profileImageUrl: user.picture || "",
                          userType: "youtube",
                          discordId: user.discord?.id || "",
                          discordUsername: user.discord?.username || "",
                        },
                        id: "WebCommandCenter",
                      };
                      if (extraCommand) {
                        payload.args.commandName = extraCommand;
                        payload.args.command = extraCommand;
                        payload.args.rawInput = extraCommand;
                        payload.args.message = extraCommand;
                      }
                      ws.send(JSON.stringify(payload));
                      startCooldown();
                    }

                    function toggleSection(el) {
                      el.nextElementSibling.classList.toggle("hidden");
                    }

                    window.addEventListener("load", () => {
                      connectBot();

                      const forceCheckbox =
                        document.getElementById("owner-force-enable");
                      const loadBtn =
                        document.getElementById("owner-load-video");
                      const clearBtn =
                        document.getElementById("owner-clear-video");
                      const videoInput =
                        document.getElementById("owner-video-id");

                      if (forceCheckbox) {
                        forceCheckbox.addEventListener("change", (e) => {
                          ownerForceEnable = e.target.checked;
                          updateStreamState(false);
                        });
                      }
                      if (loadBtn) {
                        loadBtn.addEventListener("click", () => {
                          const id = videoInput && videoInput.value.trim();
                          if (!id) return;
                          ownerOverrideVideoId = id;
                          applyOwnerVideoOverride(id);
                          updateStreamState(false);
                        });
                      }
                      if (videoInput) {
                        videoInput.addEventListener("keydown", (e) => {
                          if (e.key === "Enter" && loadBtn) loadBtn.click();
                        });
                      }
                      if (clearBtn) {
                        clearBtn.addEventListener("click", () => {
                          clearOwnerVideoOverride();
                          updateStreamState(false);
                        });
                      }
                    });

                    const theaterBtn = document.getElementById("theater-btn");
                    const videoContainer =
                      document.getElementById("video-container");
                    let isTheater = false;
                    let theaterSlot = null;

                    function setTheater(on) {
                      if (!videoContainer || !theaterBtn || on === isTheater)
                        return;
                      isTheater = on;
                      if (on) {
                        theaterSlot = document.createComment("theater-slot");
                        videoContainer.parentNode.insertBefore(
                          theaterSlot,
                          videoContainer,
                        );
                        document.body.appendChild(videoContainer);
                        videoContainer.classList.add("is-theater");
                        document.body.style.overflow = "hidden";
                        theaterBtn.textContent = "Exit";
                      } else {
                        videoContainer.classList.remove("is-theater");
                        if (theaterSlot && theaterSlot.parentNode) {
                          theaterSlot.parentNode.insertBefore(
                            videoContainer,
                            theaterSlot,
                          );
                          theaterSlot.remove();
                          theaterSlot = null;
                        }
                        document.body.style.overflow = "";
                        theaterBtn.textContent = "Theater";
                      }
                    }

                    theaterBtn?.addEventListener("click", (e) => {
                      e.preventDefault();
                      e.stopPropagation();
                      setTheater(!isTheater);
                    });

                    document.addEventListener("keydown", (e) => {
                      if (e.key === "Escape" && isTheater) setTheater(false);
                    });
                  </script>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div></MainLayout
