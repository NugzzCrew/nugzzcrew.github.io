---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Live Hub">
  <div class="page-shell">
    <header class="page-head">
      <h1 class="page-title">
        <span class="text-white">Live</span> <span class="text-gold">Hub</span>
      </h1>
      <p class="page-kicker">Fam Bam Live Hub — Stream, Chat Fam Bam Live Hub — Stream, Chat Fam Bam Command Center — Live Stream + Chat + Commands Commands Commands</p>
    </header>

    <!-- Stream Stage -->
    <div id="stream-stage" class="mb-8 flex flex-col items-center">
      <div id="video-chat-row" class="w-full max-w-6xl flex flex-col lg:flex-row gap-4 items-stretch justify-center">
        <!-- Video column -->
        <div id="video-col" class="w-full max-w-4xl mx-auto transition-all">
          <div id="video-container" class="relative aspect-video w-full rounded-xl md:rounded-2xl border border-zinc-800 overflow-hidden bg-black border-t-4 border-t-gold">
            <img
              id="offline-placeholder"
              src="/images/offline.png"
              alt="Stream is currently offline"
              class="absolute inset-0 w-full h-full object-cover"
              style="z-index:10;"
            />
            <iframe
              id="yt-video-frame"
              class="w-full h-full"
              src="about:blank"
              allow="autoplay; encrypted-media"
              allowfullscreen
              style="display:none; position:relative; z-index:20;"
            ></iframe>
            <button
              id="theater-btn"
              type="button"
              class="absolute bottom-3 right-3 z-30 bg-black/80 hover:bg-black text-white text-xs uppercase tracking-widest px-3 py-1.5 rounded-lg border border-zinc-600 hover:border-gold"
            >
              Theater
            </button>
          </div>
        </div>

        <!-- Desktop Chat (hidden by default) -->
        <div id="chat-wrapper" class="hidden lg:w-[380px] xl:w-[400px] flex-shrink-0">
          <div class="h-full rounded-xl md:rounded-2xl border border-zinc-800 overflow-hidden bg-zinc-900/40 border-t-4 border-t-gold">
            <iframe
              id="yt-chat-frame"
              class="w-full h-full"
              src="about:blank"
            ></iframe>
          </div>
        </div>
      </div>

      <!-- Mobile Chat (hidden by default) -->
      <div id="chat-wrapper-mobile" class="lg:hidden mt-4 w-full max-w-4xl hidden">
        <div class="rounded-xl border border-zinc-800 overflow-hidden bg-zinc-900/40 border-t-4 border-t-gold">
          <iframe
            id="yt-chat-frame-mobile"
            class="w-full h-[480px]"
            src="about:blank"
          ></iframe>
        </div>
      </div>
    </div>

    <!-- Commands (width matched to video) -->
    <div id="commands-container" class="nugzz-card w-full max-w-4xl mx-auto">
      <h2 class="font-header text-gold uppercase tracking-wide text-lg mb-2 text-center">Command Center</h2>
      <p id="status-msg" class="text-sm text-zinc-400 mb-4 text-center">Connecting to Streamer.bot...</p>

      <h3 class="text-sm uppercase tracking-widest text-zinc-300 mb-2 cursor-pointer flex items-center justify-between" onclick="toggleSection(this)">
        Fun Stuff & Games <span class="text-gold">▼</span>
      </h3>
      <div class="btn-grid collapsible-content grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2 mb-4">
        <button class="cmd-btn stream-cmd" onclick="sendAction('2) Join Game (Command)')" disabled>Join Whammy</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('Plinko 2 -  Join Game (Command)')" disabled>Join Plinko</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('Barrel Roll')" disabled>Barrel Roll</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('Haduken')" disabled>Haduken</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('Shoryuken')" disabled>Shoryuken</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('Scorpion')" disabled>Scorpion</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('BallDrop')" disabled>BallDrop</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('BallDrop BlackHole')" disabled>BallDrop BlackHole</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('BallDrop Explode')" disabled>BallDrop Explode</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('Bombs Away')" disabled>Bombs Away</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('Skeletor')" disabled>Skeletor</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('GTA Wasted')" disabled>GTA Wasted</button>
      </div>

      <h3 class="text-sm uppercase tracking-widest text-zinc-300 mb-2 cursor-pointer flex items-center justify-between" onclick="toggleSection(this)">
        Media Controls <span class="text-gold">▼</span>
      </h3>
      <div class="media-bar collapsible-content flex gap-2 mb-4 justify-center">
        <button class="cmd-btn stream-cmd" onclick="sendAction('Media Previous')" disabled>⏮</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('Media Stop')" disabled>⏹</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('Media Play')" disabled>▶</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('Media Pause')" disabled>⏸</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('Media Skip')" disabled>⏭</button>
      </div>

      <h3 class="text-sm uppercase tracking-widest text-zinc-300 mb-2 cursor-pointer flex items-center justify-between" onclick="toggleSection(this)">
        Album Selection <span class="text-gold">▼</span>
      </h3>
      <div class="btn-grid collapsible-content grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2">
        <button class="cmd-btn stream-cmd" onclick="sendAction('Select Album', 'Ashes')" disabled>Ashes</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('Select Album', 'Glitch')" disabled>Glitch</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('Select Album', 'Lofi')" disabled>Lofi</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('Select Album', 'Dim Sum')" disabled>Dim Sum</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('Select Album', 'Gangsta')" disabled>Gangsta</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('Select Album', 'Los Santos')" disabled>Los Santos</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('Select Album', 'Neon')" disabled>Neon</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('Select Album', 'Funk')" disabled>Funk</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('Select Album', 'Outlaws')" disabled>Outlaws</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('Select Album', 'Rowdy')" disabled>Rowdy</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('Select Album', 'Lonesome')" disabled>Lonesome</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('Select Album', 'Nugzz')" disabled>Nugzz</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('Select Album', 'Wasteland Holler')" disabled>Wasteland Holler</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('Select Album', 'LS Chronicles')" disabled>LS Chronicles</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('Select Album', 'Favorites')" disabled>Favorites</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('Select Album', 'Coastal')" disabled>Coastal</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('Select Album', 'Echoes')" disabled>Echoes</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('Select Album', 'Naked')" disabled>Naked</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('Select Album', 'Empire')" disabled>Empire</button>
      </div>
    </div>
  </div>
</MainLayout>

<script is:inline>
  let ws;

  function connectBot() {
    ws = new WebSocket("wss://wss.officialnugzzcrew.com/");

    ws.onopen = () => {
      ws.send(JSON.stringify({ request: "Subscribe", events: { general: ["Custom"] }, id: "SubRequest" }));
      setTimeout(() => {
        ws.send(JSON.stringify({ request: "DoAction", action: { name: "Web_Request_Status" }, id: "StatusCheck" }));
      }, 1000);
    };

    ws.onmessage = (event) => {
      try {
        const msg = JSON.parse(event.data);
        if (msg.data && msg.data.data && msg.data.data.name === "LiveStatusUpdate") {
          const data = msg.data.data;
          handleLiveStatus(data);
          updateStreamState(data.isLive);
        }
      } catch (e) {
        console.log("Parsing error:", e);
      }
    };

    ws.onclose = () => {
      const el = document.getElementById("status-msg");
      if (el) el.textContent = "Offline: Streamer's PC not reachable.";
      setTimeout(connectBot, 5000);
    };
  }

  function handleLiveStatus(data) {
    const videoFrame = document.getElementById("yt-video-frame");
    const placeholder = document.getElementById("offline-placeholder");
    const chatFrame = document.getElementById("yt-chat-frame");
    const chatFrameMobile = document.getElementById("yt-chat-frame-mobile");
    const chatWrapper = document.getElementById("chat-wrapper");
    const chatWrapperMobile = document.getElementById("chat-wrapper-mobile");
    const videoCol = document.getElementById("video-col");
    const commands = document.getElementById("commands-container");

    const isLive = data.isLive === true && data.videoId && data.videoId.trim() !== "";

    if (isLive) {
      if (videoFrame) {
        videoFrame.style.display = "block";
        videoFrame.src = `https://www.youtube.com/embed/${data.videoId}?autoplay=1&mute=1`;
      }
      if (placeholder) placeholder.style.display = "none";

      const chatSrc = `https://www.youtube.com/live_chat?v=${data.videoId}&embed_domain=${location.hostname}&dark_theme=1`;
      if (chatFrame) chatFrame.src = chatSrc;
      if (chatFrameMobile) chatFrameMobile.src = chatSrc;

      if (chatWrapper) chatWrapper.classList.remove("hidden");
      if (chatWrapperMobile) chatWrapperMobile.classList.remove("hidden");

      // Expand layout when live
      if (videoCol) {
        videoCol.classList.remove("max-w-4xl", "mx-auto");
        videoCol.classList.add("flex-1", "min-w-0");
      }
      if (commands) {
        commands.classList.remove("max-w-4xl");
        commands.classList.add("max-w-6xl");
      }
    } else {
      if (videoFrame) {
        videoFrame.style.display = "none";
        videoFrame.src = "about:blank";
      }
      if (placeholder) placeholder.style.display = "block";

      if (chatWrapper) chatWrapper.classList.add("hidden");
      if (chatWrapperMobile) chatWrapperMobile.classList.add("hidden");

      // Centered offline layout
      if (videoCol) {
        videoCol.classList.add("max-w-4xl", "mx-auto");
        videoCol.classList.remove("flex-1", "min-w-0");
      }
      if (commands) {
        commands.classList.add("max-w-4xl");
        commands.classList.remove("max-w-6xl");
      }
    }
  }

  function updateStreamState(live) {
    const msgEl = document.getElementById("status-msg");
    const buttons = document.querySelectorAll(".stream-cmd");
    const user = JSON.parse(localStorage.getItem("nugzzUser") || "null");
    if (!msgEl) return;

    if (ws?.readyState === WebSocket.OPEN && user) {
      buttons.forEach(btn => btn.disabled = !live);
      msgEl.textContent = live ? "Bot Connected (Stream Online)" : "Bot Connected (Stream Offline)";
      msgEl.style.color = live ? "#4ade80" : "#a1a1aa";
    } else {
      buttons.forEach(btn => btn.disabled = true);
      msgEl.textContent = user ? "Connecting to Streamer.bot..." : "Sign in to trigger commands.";
    }
  }

  function sendAction(actionName, extraCommand = null) {
    const user = JSON.parse(localStorage.getItem("nugzzUser") || "null");
    if (!ws || ws.readyState !== WebSocket.OPEN) {
      alert("Not connected to Crew Controls.");
      return;
    }
    if (!user) {
      alert("Please sign in to use commands.");
      return;
    }
    const payload = {
      request: "DoAction",
      action: { name: actionName },
      args: {
        isWebsocketRequest: "True",
        userId: user.youtubeId,
        userProfileUrl: user.picture,
        userName: user.name,
        userType: "youtube"
      },
      id: "WebCommandCenter"
    };
    if (extraCommand) {
      payload.args.commandName = extraCommand;
      payload.args.command = extraCommand;
    }
    ws.send(JSON.stringify(payload));
  }

  function toggleSection(el) {
    el.nextElementSibling.classList.toggle("hidden");
  }

  window.addEventListener("load", connectBot);

  // Theater Mode
  const theaterBtn = document.getElementById("theater-btn");
  const videoContainer = document.getElementById("video-container");
  let isTheater = false;
  let theaterSlot = null;

  function setTheater(on) {
    if (!videoContainer || !theaterBtn || on === isTheater) return;
    isTheater = on;
    if (on) {
      theaterSlot = document.createComment("theater-slot");
      videoContainer.parentNode.insertBefore(theaterSlot, videoContainer);
      document.body.appendChild(videoContainer);
      videoContainer.classList.add("is-theater");
      document.body.style.overflow = "hidden";
      theaterBtn.textContent = "Exit";
    } else {
      videoContainer.classList.remove("is-theater");
      if (theaterSlot && theaterSlot.parentNode) {
        theaterSlot.parentNode.insertBefore(videoContainer, theaterSlot);
        theaterSlot.remove();
        theaterSlot = null;
      }
      document.body.style.overflow = "";
      theaterBtn.textContent = "Theater";
    }
  }

  theaterBtn?.addEventListener("click", (e) => {
    e.preventDefault();
    e.stopPropagation();
    setTheater(!isTheater);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isTheater) setTheater(false);
  });
</script>
