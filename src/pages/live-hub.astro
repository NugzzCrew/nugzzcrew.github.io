---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Live Hub">
  <div class="page-shell">
    <header class="page-head">
      <h1 class="page-title">
        <span class="text-white">Live</span>
        <span class="text-gold">Hub</span>
      </h1>
      <p class="page-kicker">Fam Bam Live Hub — Stream, Chat & Commands</p>
    </header>

    <!-- Stream Stage -->
    <div id="stream-stage" class="mb-8 flex flex-col items-center">
      <div
        id="video-chat-row"
        class="w-full max-w-6xl flex flex-col lg:flex-row gap-4 items-stretch justify-center"
      >
        <!-- Video column -->
        <div id="video-col" class="w-full max-w-4xl mx-auto transition-all">
          <div
            id="video-container"
            class="relative aspect-video w-full rounded-xl md:rounded-2xl border border-zinc-800 overflow-hidden bg-black border-t-4 border-t-gold"
          >
            <img
              id="offline-placeholder"
              src="/images/offline.png"
              alt="Stream is currently offline"
              class="absolute inset-0 w-full h-full object-cover"
              style="z-index:10;"
            />
            <iframe
              id="yt-video-frame"
              class="w-full h-full"
              src="about:blank"
              allow="autoplay; encrypted-media"
              allowfullscreen
              style="display:none; position:relative; z-index:20;"></iframe>
            <button
              id="theater-btn"
              type="button"
              class="absolute bottom-3 right-3 z-30 bg-black/80 hover:bg-black text-white text-xs uppercase tracking-widest px-3 py-1.5 rounded-lg border border-zinc-600 hover:border-gold"
            >
              Theater
            </button>
          </div>
        </div>

        <!-- Desktop Chat (hidden by default) -->
        <div
          id="chat-wrapper"
          class="hidden lg:w-[380px] xl:w-[400px] flex-shrink-0"
        >
          <div
            class="h-full rounded-xl md:rounded-2xl border border-zinc-800 overflow-hidden bg-zinc-900/40 border-t-4 border-t-gold"
          >
            <iframe id="yt-chat-frame" class="w-full h-full" src="about:blank"
            ></iframe>
          </div>
        </div>
      </div>

      <!-- Mobile Chat (hidden by default) -->
      <div
        id="chat-wrapper-mobile"
        class="lg:hidden mt-4 w-full max-w-4xl hidden"
      >
        <div
          class="rounded-xl border border-zinc-800 overflow-hidden bg-zinc-900/40 border-t-4 border-t-gold"
        >
          <iframe
            id="yt-chat-frame-mobile"
            class="w-full h-[480px]"
            src="about:blank"></iframe>
        </div>
      </div>
    </div>

    <!-- Commands -->
    <div
      id="commands-container"
      class="nugzz-card w-full max-w-4xl mx-auto relative"
    >
      <!-- Link Discord Button -->
      <button
        id="link-discord-btn"
        class="absolute top-4 right-4 bg-zinc-800 hover:bg-zinc-700 text-gold text-xs uppercase tracking-widest px-3 py-1.5 rounded border border-zinc-600 hover:border-gold transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
        onclick="handleLinkDiscord()"
        disabled
      >
        Link Discord
      </button>

      <h2
        class="font-header text-gold uppercase tracking-wide text-lg mb-2 text-center"
      >
        COMMAND CENTER
      </h2>
      <p id="status-msg" class="text-sm text-zinc-400 mb-4 text-center">
        Connecting to Streamer.bot...
      </p>

      <!-- Owner Debug Tools (only visible to channel owner) -->
      <div id="owner-debug-tools" class="owner-debug-tools hidden mb-4">
        <label class="owner-debug-toggle">
          <input type="checkbox" id="owner-force-enable" />
          <span>Force commands enabled (offline preview)</span>
        </label>
        <div class="owner-video-override">
          <label for="owner-video-id">Test Video ID:</label>
          <input
            type="text"
            id="owner-video-id"
            placeholder="paste YouTube video ID"
            maxlength="20"
          />
          <button type="button" id="owner-load-video" class="cmd-btn"
            >Load</button
          >
          <button type="button" id="owner-clear-video" class="cmd-btn"
            >Clear</button
          >
        </div>
      </div>

      <!-- Music Controls -->
      <div class="mb-6 flex justify-center">
        <div
          class="inline-flex items-center gap-1 sm:gap-2 bg-zinc-900/70 border border-zinc-700 rounded-full px-3 py-2 shadow-inner"
        >
          <button
            class="music-btn stream-cmd"
            onclick="sendAction('Media Previous')"
            title="Previous"
            disabled
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
              ><path d="M6 6h2v12H6zm3.5 6 8.5 6V6z"></path></svg
            >
          </button>
          <button
            class="music-btn stream-cmd"
            onclick="sendAction('Media Play')"
            title="Play"
            disabled
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"
