            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"
              ><path d="M6 19h4V5H6zm8-14v14h4V5z"></path></svg
            >
          </button>
          <button
            class="music-btn stream-cmd"
            onclick="sendAction('Media Stop')"
            title="Stop"
            disabled
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
              ><path d="M6 6h12v12H6z"></path></svg
            >
          </button>
          <button
            class="music-btn stream-cmd"
            onclick="sendAction('Media Skip')"
            title="Skip"
            disabled
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
              ><path d="M6 18l8.5-6L6 6zm10 0V6h2v12z"></path></svg
            >
          </button>
          <span class="w-px h-6 bg-zinc-600 mx-1"></span>
          <button
            class="music-btn stream-cmd text-xs uppercase tracking-wider"
            onclick="sendAction('Media Show')"
            title="Show Media"
            disabled>Show</button
          >
          <button
            class="music-btn stream-cmd text-xs uppercase tracking-wider"
            onclick="sendAction('Media Hide')"
            title="Hide Media"
            disabled>Hide</button
          >
        </div>
      </div>

