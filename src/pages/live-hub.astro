---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Live Hub">
  <div class="page-shell">
    <header class="page-head">
      <h1 class="page-title">
        <span class="text-white">Live</span> <span class="text-gold">Hub</span>
      </h1>
      <p class="page-kicker">Fam Bam Live Hub — Stream, Chat & Commands</p>
    </header>

    <!-- Stream Stage -->
    <div id="stream-stage" class="mb-8 flex flex-col items-center">
      <div id="video-chat-row" class="w-full max-w-6xl flex flex-col lg:flex-row gap-4 items-stretch justify-center">
        <!-- Video column -->
        <div id="video-col" class="w-full max-w-4xl mx-auto transition-all">
          <div id="video-container" class="relative aspect-video w-full rounded-xl md:rounded-2xl border border-zinc-800 overflow-hidden bg-black border-t-4 border-t-gold">
            <img
              id="offline-placeholder"
              src="/images/offline.png"
              alt="Stream is currently offline"
              class="absolute inset-0 w-full h-full object-cover"
              style="z-index:10;"
            />
            <iframe
              id="yt-video-frame"
              class="w-full h-full"
              src="about:blank"
              allow="autoplay; encrypted-media"
              allowfullscreen
              style="display:none; position:relative; z-index:20;"
            ></iframe>
            <button
              id="theater-btn"
              type="button"
              class="absolute bottom-3 right-3 z-30 bg-black/80 hover:bg-black text-white text-xs uppercase tracking-widest px-3 py-1.5 rounded-lg border border-zinc-600 hover:border-gold"
            >
              Theater
            </button>
          </div>
        </div>

        <!-- Desktop Chat (hidden by default) -->
        <div id="chat-wrapper" class="hidden lg:w-[380px] xl:w-[400px] flex-shrink-0">
          <div class="h-full rounded-xl md:rounded-2xl border border-zinc-800 overflow-hidden bg-zinc-900/40 border-t-4 border-t-gold">
            <iframe
              id="yt-chat-frame"
              class="w-full h-full"
              src="about:blank"
            ></iframe>
          </div>
        </div>
      </div>

      <!-- Mobile Chat (hidden by default) -->
      <div id="chat-wrapper-mobile" class="lg:hidden mt-4 w-full max-w-4xl hidden">
        <div class="rounded-xl border border-zinc-800 overflow-hidden bg-zinc-900/40 border-t-4 border-t-gold">
          <iframe
            id="yt-chat-frame-mobile"
            class="w-full h-[480px]"
            src="about:blank"
          ></iframe>
        </div>
      </div>
    </div>

    <!-- Commands -->
    <div id="commands-container" class="nugzz-card w-full max-w-4xl mx-auto">
      <h2 class="font-header text-gold uppercase tracking-wide text-lg mb-2 text-center">Command Center</h2>
      <p id="status-msg" class="text-sm text-zinc-400 mb-4 text-center">Connecting to Streamer.bot...</p>

      <!-- Info & Rules -->
      <h3 class="text-sm uppercase tracking-widest text-zinc-300 mb-2 cursor-pointer flex items-center justify-between" onclick="toggleSection(this)">
        Info & Rules <span class="text-gold">▼</span>
      </h3>
      <div class="btn-grid collapsible-content grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2 mb-4">
        <button class="cmd-btn stream-cmd" onclick="sendAction('Rules')" disabled>Rules</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('Commands')" disabled>Commands</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('Clean')" disabled>Clean</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('Scratched')" disabled>Scratched</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('Membership')" disabled>Membership</button>
        <button class="cmd-btn stream-cmd" onclick="sendAction('Gamertag')" disabled>Gamertag</button>
