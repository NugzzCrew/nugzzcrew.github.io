          onclick="sendAction('RollCall')"
          disabled>Roll Call</button
        >
        <button
          class="cmd-btn stream-cmd"
          onclick="sendAction('Points')"
          disabled>Points</button
        >
        <button class="cmd-btn stream-cmd" onclick="sendAction('WT')" disabled
          >Watch Time</button
        >
        <button
          class="cmd-btn stream-cmd"
          onclick="sendAction('WhoGifted')"
          disabled>Who Gifted</button
