---
import MainLayout from "../layouts/MainLayout.astro";
import colors from "../data/colors.json";
import vehicles from "../data/vehicles.json";
import rimData from "../data/rim-data.json";
import vehicleUrls from "../data/vehicles-urls.json";
import wheelUrls from "../data/wheels-urls.json";

const unselectedSecondary = colors.filter((c) => !c.secondary);
const allUnselected = colors.filter(
  (c) => !c.primary || !c.secondary || !c.pearl || !c.rim || !c.interior,
);

const wheelCategories = rimData.categories;
const rimPaths = rimData.paths;

const lightColors = [
  { name: "White", rgb: "222, 222, 255" },
  { name: "Pure White", rgb: "255, 255, 255" },
  { name: "Blue", rgb: "2, 21, 255" },
  { name: "Electric Blue", rgb: "3, 83, 255" },
  { name: "Mint Green", rgb: "0, 255, 140" },
  { name: "Lime Green", rgb: "94, 255, 1" },
  { name: "Yellow", rgb: "255, 255, 0" },
  { name: "Golden Shower", rgb: "255, 150, 5" },
  { name: "Orange", rgb: "255, 62, 0" },
  { name: "Red", rgb: "255, 1, 1" },
  { name: "Pony Pink", rgb: "255, 50, 100" },
  { name: "Hot Pink", rgb: "255, 5, 190" },
  { name: "Purple", rgb: "35, 1, 255" },
  { name: "Black Light", rgb: "15, 3, 255" }
];

const plateData = [
  { name: "North Yankton", file: "Yankton.png", color: "#0A0A0A" },
  { name: "E-Cola", file: "ECola.png", color: "#FFFFFF" },
  { name: "Las Venturas", file: "LosVenturas.png", color: "#112A61" },
  { name: "Liberty City", file: "LibertyCity.png", color: "#112A61" },
  { name: "LSCM", file: "LSCM.png", color: "#0A0A0A" },
  { name: "Panic", file: "Panic.png", color: "#F7B815" },
  { name: "Pounders", file: "Pounders.png", color: "#F7B815" },
  { name: "Sprunk", file: "Sprunk.png", color: "#FFFFFF" }
];

const windowTints = ["Clear", "Green"];
const neonOptions = ["None", "Match Headlights", "Pure White", "Blue", "Electric Blue", "Mint Green", "Lime Green", "Yellow", "Golden Shower", "Orange", "Red", "Pony Pink", "Hot Pink", "Purple", "Black Light", "Custom RGB"];

const tireDesignMap = {
  "Bennys Bespoke": ["Atomic", "Blue Lines", "Classic White Wall", "Red Lines", "Retro White Wall", "White Lines"],
  "Bennys Originals": ["Atomic", "Blue Lines", "Classic White Wall", "Red Lines", "Retro White Wall", "White Lines"],
  "Bike": [],
  "High End": [],
  "Lowrider": [],
  "Muscle": [],
  "Offroad": [],
  "Race": ["Atomic (Blue/White)", "Atomic (White)", "Fukaru White", "Fukaru Red", "Chepalle Yellow", "Chepalle Green"],
  "Sport": [],
  "Street": ["Atomic White", "Atomic Yellow", "Fukaru White", "Fukaru Red", "Chepalle Yellow", "Chepalle Green"],
  "SUV": [],
  "Track": ["Atomic White", "Atomic Yellow", "Fukaru White", "Fukaru Red", "Chepalle Yellow", "Chepalle Green"],
  "Tuner": []
};

// Map (category, display name) → filename suffix pattern
// Benny's: base has no letter, b=white lines, c=classic white wall, d=retro white wall, e=red lines, f=blue lines, g=atomic
// Race: base has no letter, a=Atomic Blue/White, b=Atomic White, c=Fukaru White, d=Fukaru Red, e=Chepalle Yellow, f=Chepalle Green
// Street/Track: a=no design, b=Atomic White, c=Atomic Yellow, d=Fukaru White, e=Fukaru Red, f=Chepalle Yellow, g=Chepalle Green
const tireSuffixMap = {
  "Bennys Bespoke|White Lines": "b", "Bennys Bespoke|Classic White Wall": "c", "Bennys Bespoke|Retro White Wall": "d", "Bennys Bespoke|Red Lines": "e", "Bennys Bespoke|Blue Lines": "f", "Bennys Bespoke|Atomic": "g",
  "Bennys Originals|White Lines": "b", "Bennys Originals|Classic White Wall": "c", "Bennys Originals|Retro White Wall": "d", "Bennys Originals|Red Lines": "e", "Bennys Originals|Blue Lines": "f", "Bennys Originals|Atomic": "g",
  "Race|Atomic (Blue/White)": "a", "Race|Atomic (White)": "b", "Race|Fukaru White": "c", "Race|Fukaru Red": "d", "Race|Chepalle Yellow": "e", "Race|Chepalle Green": "f",
  "Street|Atomic White": "b", "Street|Atomic Yellow": "c", "Street|Fukaru White": "d", "Street|Fukaru Red": "e", "Street|Chepalle Yellow": "f", "Street|Chepalle Green": "g",
  "Track|Atomic White": "b", "Track|Atomic Yellow": "c", "Track|Fukaru White": "d", "Track|Fukaru Red": "e", "Track|Chepalle Yellow": "f", "Track|Chepalle Green": "g"
};

const tireSmokeOptions = ["Match Headlights", "Match Neon", "Patriot", "Custom RGB"];
const vehicleSets = [
  "Facility Set",
  "Nightclub Set",
  "Arena Set",
  "Special Vehicle Set",
  "Set 1 Set",
  "Set 2 Set"
];

---

<MainLayout title="DMO Generator">
  <div class="page-shell">
    <header class="page-head">
      <h1 class="page-title">
        <span class="text-white">DMO</span>
        <span class="text-gold">Gen</span>
      </h1>
      <p class="page-kicker">Step-by-Step Spec Builder</p>
    </header>

    <!-- Step Progress Bar -->
    <div id="dmo-builder" class="jump">
    <div class="flex justify-between mb-8 border-b border-zinc-800 pb-4">
      <button id="nav-step-1" class="step-nav text-gold font-black uppercase text-xs tracking-widest cursor-pointer">1. Vehicle</button>
      <button id="nav-step-2" class="step-nav text-zinc-500 font-black uppercase text-xs tracking-widest cursor-pointer hover:text-zinc-300">2. Plate</button>
      <button id="nav-step-3" class="step-nav text-zinc-500 font-black uppercase text-xs tracking-widest cursor-pointer hover:text-zinc-300">3. Colors</button>
      <button id="nav-step-4" class="step-nav text-zinc-500 font-black uppercase text-xs tracking-widest cursor-pointer hover:text-zinc-300">4. Wheels</button>
    </div>

    <!-- Main Content Container -->
    <div class="bg-zinc-900/40 p-6 rounded-3xl border border-zinc-800 space-y-6 min-h-[500px] flex flex-col justify-between">
      
      <!-- STEP 1: VEHICLE -->
      <div id="step-1" class="step-section space-y-6">
        <h2 class="text-gold font-black uppercase text-lg mb-4">Vehicle Details</h2>

        <!-- Mode Toggle -->
        <div class="flex gap-4 mb-4">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="radio" name="vehicleMode" value="vehicle" checked class="accent-gold" />
            <span class="text-[11px] uppercase font-black tracking-widest text-white">Vehicle</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="radio" name="vehicleMode" value="set" class="accent-gold" />
            <span class="text-[11px] uppercase font-black tracking-widest text-white">Set</span>
          </label>
        </div>

        <!-- Vehicle Search + Dropdown -->
        <div id="vehicle-selector">
          <label class="block text-[10px] text-gold uppercase font-black mb-1">Search & Select Vehicle (Required):</label>
          <div>
            <input type="text" id="vehicleSearch" placeholder="Type to filter (e.g. Buffalo, Dominator, Vigero...)" autocomplete="off"
              class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold" />
            <div id="vehicleDropdown" class="w-full mt-1 max-h-60 overflow-y-auto bg-zinc-950 border border-zinc-800 rounded-lg shadow-2xl hidden"></div>
          </div>
          <p id="vehicleSelectedLabel" class="text-[10px] text-zinc-400 mt-2 min-h-[1.2em]"></p>
          <div id="vehiclePreviewWrap" class="mt-3 hidden">
            <img id="vehiclePreviewImg" src="" alt="Vehicle" class="max-h-40 mx-auto rounded-lg border border-zinc-700 bg-black object-contain" />
          </div>
          <input type="hidden" id="vehicle" />
        </div>

        <!-- Set Selector -->
        <div id="set-selector" class="hidden">
          <label class="block text-[10px] text-gold uppercase font-black mb-1">Select Set (Required):</label>
          <select id="vehicleSet" class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold">
            <option value="">— Choose a Set —</option>
            {vehicleSets.map(s => <option value={s}>{s}</option>)}
          </select>
        </div>

        <div class="flex gap-3 pt-6 border-t border-zinc-800">
          <button id="btn-next-1" disabled class="w-full bg-zinc-800 disabled:opacity-40 disabled:cursor-not-allowed hover:bg-gold hover:text-black text-white font-black uppercase py-3 rounded-xl text-xs tracking-widest transition-all">Next: Plates</button>
        </div>
      </div>

      <!-- STEP 2: PLATE -->
      <div id="step-2" class="step-section space-y-6 hidden">
        <h2 class="text-gold font-black uppercase text-lg mb-4">License Plate</h2>
        <div class="flex flex-col md:flex-row gap-6">
          <div class="flex-1 space-y-4">
            <div>
              <label class="block text-[10px] text-gold uppercase font-black mb-1">Plate Style:</label>
              <select id="plateStyle" class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold">
                {plateData.map(p => <option value={p.name} data-file={p.file} data-color={p.color}>{p.name}</option>)}
              </select>
            </div>
            <div>
              <label class="block text-[10px] text-gold uppercase font-black mb-1">Plate Text (Exact 8 Chars. Alphanumeric only):</label>
              <input type="text" id="plate" maxlength="8" placeholder="8 CHARACTERS" class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm uppercase font-mono outline-none focus:border-gold tracking-[0.3em]" />
              <p class="text-[9px] text-zinc-500 mt-2">Spaces will automatically turn into underscores <span class="text-white">_</span> to help you count characters. Special characters are disabled.</p>
            </div>
            <div class="flex items-center gap-3 p-3 bg-zinc-800/50 rounded-lg border border-zinc-700">
              <input type="checkbox" id="blanktonToggle" class="w-4 h-4 accent-gold cursor-pointer" />
              <label for="blanktonToggle" class="text-[10px] text-zinc-300 uppercase font-black cursor-pointer tracking-widest">Apply BLANKTON</label>
            </div>
          </div>

          <div class="flex-1 flex flex-col items-center justify-center">
            <label class="block text-[10px] text-gold uppercase font-black mb-2 w-full text-center">Live Preview:</label>
            <div class="relative w-[256px] h-[128px] rounded overflow-hidden shadow-2xl border border-zinc-700 bg-black">
              <img id="platePreviewImg" src={`/images/plates/${plateData[0].file}`} alt="Plate Background" class="absolute inset-0 w-full h-full object-cover" />
              <div class="absolute top-[56%] left-1/2 -translate-x-1/2 -translate-y-1/2 w-full text-center pointer-events-none drop-shadow-md">
                <span id="platePreviewText" class="text-[24px] leading-none font-black uppercase tracking-[0.14em] whitespace-pre inline-block" style={`font-family: 'Courier New', Courier, monospace; transform: scaleY(2.1); color: ${plateData[0].color};`}></span>
              </div>
            </div>
          </div>
        </div>

        <div class="flex gap-3 pt-6 border-t border-zinc-800">
          <button id="btn-prev-2" class="flex-1 bg-zinc-800 hover:bg-zinc-700 text-white font-black uppercase py-3 rounded-xl text-xs tracking-widest transition-all">Back</button>
          <button id="btn-next-2" class="flex-1 bg-zinc-800 hover:bg-gold hover:text-black text-white font-black uppercase py-3 rounded-xl text-xs tracking-widest transition-all">Next: Colors</button>
        </div>
      </div>

      <!-- STEP 3: COLORS & EXTRAS -->
      <div id="step-3" class="step-section space-y-4 hidden">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-4 gap-4">
          <h2 class="text-gold font-black uppercase text-lg">Paints, Lights & Extras</h2>
          <div class="flex gap-2 w-full md:w-auto">
            <button id="btn-rand-vivid" type="button" class="flex-1 md:flex-none bg-blue-600/20 hover:bg-blue-500 hover:text-white border border-blue-500/50 text-blue-400 font-black uppercase py-2 px-3 rounded-lg text-[10px] tracking-widest transition-all shadow-[0_0_10px_rgba(37,99,235,0.2)]">Random: Vivid</button>
            <button id="btn-rand-real" type="button" class="flex-1 md:flex-none bg-zinc-800 hover:bg-zinc-600 border border-zinc-600 text-white font-black uppercase py-2 px-3 rounded-lg text-[10px] tracking-widest transition-all">Random: Realistic</button>
          </div>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-[10px] text-gold uppercase font-black mb-1">Window Tint:</label>
            <select id="windows" class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold">
              <option value="">-- Select --</option>
              {windowTints.map((w) => <option value={w}>{w}</option>)}
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="space-y-1">
            <label class="block text-[10px] text-gold uppercase font-black mb-1">Primary:</label>
            <div class="flex gap-2 items-stretch">
              <select id="primary" class="min-w-0 flex-1 bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold"></select>
              <div id="primaryPrev" class="w-10 h-12 rounded border border-zinc-700 bg-zinc-800 flex-shrink-0"></div>
            </div>
            <select id="primaryTexture" class="hidden w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold mt-2">
              <option value="">-- Select Base Texture --</option>
              <option value="Super Glossy">Super Glossy</option>
              <option value="Glossy">Glossy</option>
              <option value="Matte/Worn">Matte/Worn</option>
            </select>
          </div>
          <div class="space-y-1">
            <label class="block text-[10px] text-gold uppercase font-black mb-1">Secondary:</label>
            <div class="flex gap-2 items-stretch">
              <select id="secondary" class="min-w-0 flex-1 bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold"></select>
              <div id="secondaryPrev" class="w-10 h-12 rounded border border-zinc-700 bg-zinc-800 flex-shrink-0"></div>
            </div>
            <select id="secondaryTexture" class="hidden w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold mt-2">
              <option value="">-- Select Base Texture --</option>
              <option value="Super Glossy">Super Glossy</option>
              <option value="Glossy">Glossy</option>
              <option value="Matte/Worn">Matte/Worn</option>
            </select>
          </div>
        </div>

        <!-- Always-visible Match Primary button -->
        <div class="mt-2">
          <button type="button" id="matchPrimaryBtn" class="w-full bg-zinc-800 hover:bg-gold hover:text-black text-white font-black uppercase py-2.5 rounded-lg text-[10px] tracking-widest transition-all border border-zinc-700">
            Match Primary → Secondary
          </button>
        </div>

        <div id="rgbInputArea" class="bg-gold/10 p-4 rounded-xl border border-gold/50 hidden mt-2">
          <label class="block text-[10px] text-gold uppercase font-black mb-2">Crew / Custom RGB or HEX (Applies to any slot set to 'Custom'):</label>
          <div class="flex gap-2 items-stretch">
            <input type="text" id="sharedRgb" placeholder="255, 255, 255 or #FFFFFF" class="min-w-0 flex-1 bg-black border-2 border-gold rounded-lg p-3 text-white text-sm font-mono outline-none" />
            <input type="color" id="colorPicker" value="#ffffff" class="w-12 h-12 rounded border-2 border-gold/60 cursor-pointer flex-shrink-0" title="Click to pick color" style="padding:0; background:none;" />
          </div>
        </div>

        <!-- Positioned color picker for tiles (not display:none so popup appears near it) -->
        <input type="color" id="tileColorPicker" class="fixed opacity-0 w-8 h-8 pointer-events-none" style="z-index:-1;" />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
          <div class="space-y-1">
            <label class="block text-[10px] text-gold uppercase font-black mb-1">Pearlescent:</label>
            <div class="flex gap-2 items-stretch">
              <select id="pearl" class="min-w-0 flex-1 bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold"></select>
              <div id="pearlPrev" class="w-10 h-12 rounded border border-zinc-700 bg-zinc-800 flex-shrink-0"></div>
            </div>
          </div>
          <div class="space-y-1">
            <label class="block text-[10px] text-gold uppercase font-black mb-1">Interior (Optional):</label>
            <div class="flex gap-2 items-stretch">
              <select id="interior" class="min-w-0 flex-1 bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold"></select>
              <div id="interiorPrev" class="w-10 h-12 rounded border border-zinc-700 bg-zinc-800 flex-shrink-0"></div>
            </div>
          </div>
        </div>

        <hr class="border-zinc-800 my-4" />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-start">
          <div class="space-y-1">
            <label class="block text-[10px] text-gold uppercase font-black mb-1">Headlights:</label>
            <div class="flex gap-2 items-stretch">
              <select id="headlights" class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold">
                <option value="">-- Select --</option>
                {lightColors.filter(h => h.name !== "Pure White").map((h) => <option value={h.name}>{h.name}</option>)}
              </select>
              <div id="headlightsPrev" class="w-10 h-12 rounded border border-zinc-700 bg-zinc-800 flex-shrink-0"></div>
            </div>
          </div>
          <div class="space-y-1">
            <label class="block text-[10px] text-gold uppercase font-black mb-1">Neon Setup:</label>
            <div class="flex gap-2 items-stretch">
              <select id="neon" class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold">
                <option value="">-- Select --</option>
                {neonOptions.map((c) => <option value={c}>{c}</option>)}
              </select>
              <div id="neonPrev" class="w-10 h-12 rounded border border-zinc-700 bg-zinc-800 flex-shrink-0"></div>
            </div>
          </div>
        </div>

        <div id="neonRgbArea" class="bg-gold/10 p-4 rounded-xl border border-gold/50 hidden mt-2">
          <label class="block text-[10px] text-gold uppercase font-black mb-2">Neon Custom RGB or HEX:</label>
          <div class="flex gap-2 items-stretch">
            <input type="text" id="neonRgb" placeholder="0, 255, 255 or #00FFFF" class="min-w-0 flex-1 bg-black border-2 border-gold rounded-lg p-3 text-white text-sm font-mono outline-none" />
            <div id="neonRgbPrev" class="w-12 h-12 rounded border border-gold/60 bg-zinc-800 flex-shrink-0"></div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
          <div class="space-y-1">
            <label class="block text-[10px] text-gold uppercase font-black mb-1">Tire Smoke:</label>
            <div class="flex gap-2 items-stretch">
              <select id="tireSmoke" class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold">
                <option value="">-- Select --</option>
                {tireSmokeOptions.map((o) => <option value={o}>{o}</option>)}
              </select>
              <div id="tireSmokePrev" class="w-10 h-12 rounded border border-zinc-700 bg-zinc-800 flex-shrink-0"></div>
            </div>
            <input type="text" id="tireSmokeCustom" placeholder="Custom RGB or HEX (e.g. 255, 0, 0 or #FF0000)" class="w-full mt-2 bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold hidden" />
          </div>
          
          <div class="space-y-1">
            <label class="block text-[10px] text-gold uppercase font-black mb-1">Livery:</label>
            <input type="text" id="livery" placeholder="Type Livery Name" class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold" />
          </div>
        </div>

        <div class="flex gap-3 pt-6 border-t border-zinc-800 mt-4">
           <button id="btn-prev-3" class="flex-1 bg-zinc-800 hover:bg-zinc-700 text-white font-black uppercase py-3 rounded-xl text-xs tracking-widest transition-all">Back</button>
           <button id="btn-next-3" class="flex-1 bg-zinc-800 hover:bg-gold hover:text-black text-white font-black uppercase py-3 rounded-xl text-xs tracking-widest transition-all">Next: Wheels</button>
        </div>
      </div>

      <!-- STEP 4: WHEELS -->
      <div id="step-4" class="step-section space-y-6 hidden">
        <div class="flex justify-between items-center mb-4">
          <h2 class="text-gold font-black uppercase text-lg">Wheels</h2>
          <button id="btn-random-wheels" type="button" class="bg-zinc-800 hover:bg-gold hover:text-black text-white font-black uppercase py-2 px-4 rounded-lg text-[10px] tracking-widest transition-all">Randomize</button>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-start">
          <div>
            <label class="block text-[10px] text-gold uppercase font-black mb-1">Wheel Category:</label>
            <select id="wheelCategory" class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold">
              <option value="">-- Select --</option>
              {Object.keys(wheelCategories).map((cat) => (
                <option value={cat}>{cat}</option>
              ))}
            </select>
          </div>
          <div>
            <label class="block text-[10px] text-gold uppercase font-black mb-1">Rim Style:</label>
            <select id="rimStyle" class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold">
              <option value="">-- Select Category First --</option>
            </select>
          </div>
        </div>

        <div id="activatorWrapper" class="hidden p-3 bg-red-900/20 rounded-lg border border-red-500/50">
          <div class="flex items-center gap-3">
            <input type="checkbox" id="activator" class="w-4 h-4 accent-red-500 cursor-pointer" />
            <label for="activator" class="text-[10px] text-red-400 uppercase font-black cursor-pointer tracking-widest">Apply Activator (Waves Selected)</label>
          </div>
        </div>

        <div class="mt-2">
          <div class="relative w-full h-96 rounded-lg border border-zinc-700 overflow-hidden bg-black flex items-center justify-center">
            <img id="wheelFull" src="" alt="Full wheel grid" class="absolute inset-0 w-full h-full object-contain" />
            <img id="tireFull" src="" alt="Full tire design overlay" class="absolute inset-0 w-full h-full object-contain hidden pointer-events-none" />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="space-y-1">
            <label class="block text-[10px] text-gold uppercase font-black mb-1">Rim Color:</label>
            <div class="flex gap-2 items-stretch">
              <select id="rimColor" class="min-w-0 flex-1 bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold"></select>
              <div id="rimColorPrev" class="w-10 h-12 rounded border border-zinc-700 bg-zinc-800 flex-shrink-0"></div>
            </div>
          </div>
          <div>
            <label class="block text-[10px] text-gold uppercase font-black mb-1">Tire Design:</label>
            <select id="tires" class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold" disabled>
              <option value="None" data-file="none" selected>-- Select Wheel Category First --</option>
            </select>
          </div>
        </div>

        <div class="flex gap-3 pt-6 border-t border-zinc-800">
          <button id="btn-prev-4" class="flex-1 bg-zinc-800 hover:bg-zinc-700 text-white font-black uppercase py-3 rounded-xl text-xs tracking-widest transition-all">Back</button>
          <button id="generate" type="button" class="flex-[2] bg-gold hover:bg-gold/90 text-black font-black uppercase py-3 rounded-xl text-xs tracking-widest transition-all shadow-[0_0_15px_rgba(212,175,55,0.4)]">Generate DMO Spec</button>
        </div>
      </div>
    </div>
    </div>

    <!-- FINAL OUTPUT (Hidden until Generated) -->
    <div id="outputContainer" class="mt-8 bg-zinc-900/40 p-6 rounded-3xl border border-zinc-800 hidden">
      <h2 class="text-sm font-black uppercase tracking-widest text-gold mb-4">Final Spec</h2>
      <pre id="output" class="text-[10px] text-zinc-300 font-mono whitespace-pre-wrap break-all bg-black/50 p-4 rounded-xl border border-zinc-800 min-h-[300px]"></pre>
      <button id="copy" type="button" class="mt-4 w-full bg-gold hover:bg-gold/90 text-black font-black uppercase py-3 rounded-xl text-xs tracking-widest transition-all">Copy</button>
      <a href="https://discord.com/channels/999413076505936023/1277822812534607882" target="_blank" rel="noopener noreferrer" class="mt-3 block w-full text-center bg-zinc-800 hover:bg-zinc-700 text-white font-black uppercase py-3 rounded-xl text-xs tracking-widest transition-all">Open the Discord channel</a>
    </div>

  </div>
</MainLayout>

<script is:inline define:vars={{ colors, unselectedSecondary, allUnselected, wheelCategories, lightColors, tireDesignMap, vehicles, rimPaths, vehicleUrls, wheelUrls }}>
  const globalHexMap = {};
  colors.forEach((c) => {
    const key = c.texture + "|" + c.name;
    globalHexMap[key] = c.hex;
  });

  const lightColorMap = {};
  lightColors.forEach((h) => {
    lightColorMap[h.name] = h.rgb;
  });

  function hexToHSL(hexStr) {
    if(!hexStr) return {h:0, s:0, l:0};
    let hex = hexStr.replace('#', '');
    if(hex.length === 3) hex = hex.split('').map(x => x+x).join('');
    let r = parseInt(hex.substring(0,2), 16)/255;
    let g = parseInt(hex.substring(2,4), 16)/255;
    let b = parseInt(hex.substring(4,6), 16)/255;
    let max = Math.max(r, g, b), min = Math.min(r, g, b);
    let h, s, l = (max + min) / 2;
    if(max === min) { h = s = 0; }
    else {
      let d = max - min;
      s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
      switch(max){
        case r: h = (g - b) / d + (g < b ? 6 : 0); break;
        case g: h = (b - r) / d + 2; break;
        case b: h = (r - g) / d + 4; break;
      }
      h /= 6;
    }
    return { h: h*360, s, l };
  }

  function getHslFromVal(val) {
    if(!val || val.startsWith("Custom")) return {h:0, s:0, l:0};
    return hexToHSL(globalHexMap[val]);
  }

  function hueDistance(h1, h2) {
    let d = Math.abs(h1 - h2);
    return d > 180 ? 360 - d : d;
  }

  let currentStep = 1;
  function showStep(step) {
    document.querySelectorAll('.step-section').forEach(el => el.classList.add('hidden'));
    document.querySelectorAll('.step-nav').forEach(el => {
      el.classList.remove('text-gold');
      el.classList.add('text-zinc-500');
    });
    
    document.getElementById(`step-${step}`).classList.remove('hidden');
    document.getElementById(`nav-step-${step}`).classList.remove('text-zinc-500');
    document.getElementById(`nav-step-${step}`).classList.add('text-gold');
    currentStep = step;
  }

  function validateStep(step) {
    if (step === 1) {
      if (!document.getElementById("vehicle").value.trim()) { alert("Please select a valid Vehicle or Set."); return false; }
    }
    if (step === 2) {
      if (document.getElementById("plate").value.length !== 8) { alert("Plate text must be EXACTLY 8 characters."); return false; }
    }
    if (step === 3) {
      const required = ["windows", "primary", "secondary", "pearl", "headlights", "neon", "tireSmoke"];
      for (let id of required) {
        if (!document.getElementById(id).value) { alert(`Please select an option for ${id}.`); return false; }
      }
      
      const pCustom = document.getElementById("primary").value === "Custom";
      const sCustom = document.getElementById("secondary").value === "Custom";
      
      if (pCustom && !document.getElementById("primaryTexture").value) { alert("Please select a Base Texture for the Custom Primary RGB."); return false; }
      if (sCustom && !document.getElementById("secondaryTexture").value) { alert("Please select a Base Texture for the Custom Secondary RGB."); return false; }
      if ((pCustom || sCustom) && !document.getElementById("sharedRgb").value) { alert("Please enter the Crew/Custom RGB value."); return false; }
      
      if (document.getElementById("neon").value === "Custom RGB" && !document.getElementById("neonRgb").value) { alert("Please enter a Custom RGB for Neon."); return false; }
      if (document.getElementById("tireSmoke").value === "Custom RGB" && !document.getElementById("tireSmokeCustom").value) { alert("Please enter a Custom RGB for Tire Smoke."); return false; }
    }
    if (step === 4) {
      const required = ["wheelCategory", "rimStyle", "rimColor", "tires"];
      for (let id of required) {
        if (!document.getElementById(id).value) { alert(`Please select an option for ${id}.`); return false; }
      }
    }
    return true;
  }

  [1, 2, 3, 4].forEach(step => {
    document.getElementById(`nav-step-${step}`).addEventListener('click', () => {
      if (step > currentStep && !validateStep(currentStep)) return;
      showStep(step);
    });
    const btnNext = document.getElementById(`btn-next-${step}`);
    const btnPrev = document.getElementById(`btn-prev-${step}`);
    if (btnNext) btnNext.addEventListener('click', () => { if(validateStep(step)) showStep(step + 1); });
    if (btnPrev) btnPrev.addEventListener('click', () => showStep(step - 1));
  });

  const plateInput = document.getElementById('plate');
  const blanktonToggle = document.getElementById('blanktonToggle');
  const plateStyleSelect = document.getElementById('plateStyle');
  const platePreviewImg = document.getElementById('platePreviewImg');
  const platePreviewText = document.getElementById('platePreviewText');

  function updatePlatePreview() {
    const selectedOption = plateStyleSelect.options[plateStyleSelect.selectedIndex];
    platePreviewImg.src = `/images/plates/${selectedOption.getAttribute('data-file')}`;
    platePreviewText.style.color = selectedOption.getAttribute('data-color');
    platePreviewText.textContent = plateInput.value.replace(/_/g, " ");
  }

  plateInput.addEventListener('input', function() {
    let val = this.value.toUpperCase();
    val = val.replace(/ /g, "_");
    val = val.replace(/[^A-Z0-9_]/g, "");
    this.value = val;

    if(blanktonToggle.checked) blanktonToggle.checked = false;
    updatePlatePreview();
  });

  plateStyleSelect.addEventListener('change', updatePlatePreview);
  
  blanktonToggle.addEventListener('change', function() {
    plateInput.value = this.checked ? "________" : "";
    updatePlatePreview();
  });

  function parseColor(input) {
    if (!input) return null;
    input = input.trim();
    if (input.startsWith("#")) {
      const hex = input.slice(1);
      if (hex.length === 6) {
        const r = parseInt(hex.slice(0, 2), 16), g = parseInt(hex.slice(2, 4), 16), b = parseInt(hex.slice(4, 6), 16);
        if (!isNaN(r) && !isNaN(g) && !isNaN(b)) return `rgb(${r}, ${g}, ${b})`;
      }
    }
    if (input.includes(",")) {
      const parts = input.split(",").map((n) => parseInt(n.trim()));
      if (parts.length === 3 && parts.every((n) => !isNaN(n) && n >= 0 && n <= 255)) return `rgb(${parts.join(", ")})`;
    }
    return null;
  }

  function makeOption(c) { return `<option value="${c.texture}|${c.name}" data-hex="${c.hex}">${c.texture} - ${c.name}</option>`; }
  
  function populatePrimary() { document.getElementById("primary").innerHTML = '<option value="">-- Select --</option><option value="Custom">Custom RGB / HEX</option>' + colors.map(makeOption).join(""); }
  function populateSecondary() { document.getElementById("secondary").innerHTML = '<option value="">-- Select --</option><option value="Custom">Custom RGB / HEX</option>' + unselectedSecondary.map(makeOption).join(""); }
  function populateUnselectedOnly(selectId, flag) { document.getElementById(selectId).innerHTML = '<option value="">-- Select --</option>' + allUnselected.filter((c) => !c[flag]).map(makeOption).join(""); }

  function slugify(s) { return s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, ""); }
  
  function updateRimThumb() {
    const cat = document.getElementById("wheelCategory").value;
    const style = document.getElementById("rimStyle").value;
    const tireSel = document.getElementById("tires");
    const tireVal = tireSel ? tireSel.value : "";
    const full = document.getElementById("wheelFull");
    let rimImg = "";
    if (style && style !== "Stock" && cat && typeof wheelUrls !== "undefined") {
      const matches = wheelUrls.filter(w => w.category === cat && w.name === style);
      // Prefer chrome, and match tire design if selected
      let candidates = matches;
      if (tireVal && tireVal !== "None" && tireVal !== "" && tireVal !== "N/A") {
        const suffixKey = cat + "|" + tireVal;
        const suffix = (typeof tireSuffixMap !== "undefined") ? tireSuffixMap[suffixKey] : null;
        if (suffix) {
          const suffixMatch = matches.filter(w => w.file && w.file.endsWith(suffix + ".webp"));
          if (suffixMatch.length) candidates = suffixMatch;
        }
      }
      const chrome = candidates.find(w => w.chrome);
      const base = candidates.find(w => !w.tire) || candidates[0];
      const pick = chrome || base;
      if (pick && pick.url) rimImg = pick.url;
    }
    if (rimImg) full.src = rimImg;
    // Hide the old overlay — tire design is now in the main image
    const tireFull = document.getElementById("tireFull");
    if (tireFull) tireFull.classList.add("hidden");
  }



  function populateTiresForCategory(cat) {
    const tireSelect = document.getElementById("tires");
    
    const options = tireDesignMap[cat] || [];

    if (!options.length) {
      tireSelect.innerHTML = '<option value="None" selected>None</option>';
      tireSelect.disabled = true;
    } else {
      tireSelect.disabled = false;
      let optionsHtml = '<option value="None">None</option>';
      optionsHtml += options.map(name => `<option value="${name}">${name}</option>`).join("");
      tireSelect.innerHTML = optionsHtml;
    }

    updateRimThumb();
  }

  function populateRims() {
    const cat = document.getElementById("wheelCategory").value;
    const sel = document.getElementById("rimStyle");
    if(!cat) { 
      sel.innerHTML = '<option value="">-- Select Category First --</option>'; 
      document.getElementById("tires").innerHTML = '<option value="None" data-file="none" selected>-- Select Wheel Category First --</option>';
      document.getElementById("tires").disabled = true;
      return; 
    }
    // Pull unique style names from wheelUrls so they match the URL data exactly
    let styles = [];
    if (typeof wheelUrls !== "undefined") {
      const seen = new Set();
      wheelUrls.filter(w => w.category === cat).forEach(w => {
        if (!seen.has(w.name)) { seen.add(w.name); styles.push(w.name); }
      });
    }
    if (!styles.length) styles = wheelCategories[cat] || [];
    sel.innerHTML = '<option value="">-- Select --</option>' + styles.map((s) => `<option value="${s}">${s}</option>`).join("");
    populateTiresForCategory(cat);
    updateRimThumb();
    const wrap = document.getElementById("activatorWrapper");
    wrap.classList.add("hidden"); document.getElementById("activator").checked = false;
  }

  function getColorForPreview(id) {
    const val = document.getElementById(id)?.value;
    if (!val) return "#111";
    if (val === "Custom" || val === "Custom RGB") {
      if (id === "neon") return parseColor(document.getElementById("neonRgb").value) || "#666";
      return parseColor(document.getElementById("sharedRgb").value) || "#666";
    }
    if (id === "headlights" || id === "neon") {
      const rgbStr = lightColorMap[val];
      return rgbStr ? `rgb(${rgbStr})` : "#111";
    }
    return globalHexMap[val] || "#111";
  }

  function refreshPreviews() {
    ["primary", "secondary", "pearl", "interior", "rimColor", "headlights", "neon"].forEach((id) => {
      const box = document.getElementById(id + "Prev");
      if (box) box.style.backgroundColor = getColorForPreview(id);
    });

    // colorPicker itself shows the color; no separate preview needed
    
    const neonBox = document.getElementById("neonRgbPrev");
    if (neonBox) neonBox.style.backgroundColor = parseColor(document.getElementById("neonRgb").value) || "#333";

    const smokeBox = document.getElementById("tireSmokePrev");
    const smokeVal = document.getElementById("tireSmoke").value;
    
    smokeBox.style.background = "";
    smokeBox.style.backgroundColor = "#111";

    if(smokeVal === "Patriot") {
      smokeBox.style.background = "linear-gradient(135deg, #FF0101 33%, #FFFFFF 33%, #FFFFFF 66%, #0215FF 66%)";
    } else if(smokeVal === "Custom RGB") {
      smokeBox.style.backgroundColor = parseColor(document.getElementById("tireSmokeCustom").value) || "#666";
    } else if(smokeVal === "Match Headlights" || smokeVal === "Match Neon") {
      let baseRgbStr = "255, 255, 255";
      if(smokeVal === "Match Headlights") {
        baseRgbStr = lightColorMap[document.getElementById("headlights").value] || "255, 255, 255";
      } else {
        const ne = document.getElementById("neon").value;
        if(ne === "Custom RGB") {
          baseRgbStr = (parseColor(document.getElementById("neonRgb").value) || "255, 255, 255").replace('rgb(','').replace(')','');
        } else {
          baseRgbStr = lightColorMap[ne] || "255, 255, 255";
        }
      }
      const parts = baseRgbStr.split(',').map(n => parseInt(n.trim()));
      parts[0] = Math.max(0, parts[0] - 1);
      smokeBox.style.backgroundColor = `rgb(${parts.join(',')})`;
    }
  }

  ["primary", "secondary", "pearl", "interior", "rimColor", "headlights"].forEach(id => {
    document.getElementById(id).addEventListener("change", refreshPreviews);
  });

  document.getElementById("rimStyle").addEventListener("change", (e) => {
    updateRimThumb();
    const wrap = document.getElementById("activatorWrapper");
    if (document.getElementById("wheelCategory").value === "Bennys Originals" && e.target.value === "Waves") wrap.classList.remove("hidden");
    else { wrap.classList.add("hidden"); document.getElementById("activator").checked = false; }
  });

  document.getElementById("wheelCategory").addEventListener("change", populateRims);
  document.getElementById("tires").addEventListener("change", updateRimThumb);

  const checkPaintCustom = () => {
    const pCustom = document.getElementById("primary").value === "Custom";
    const sCustom = document.getElementById("secondary").value === "Custom";
    
    document.getElementById("primaryTexture").classList.toggle("hidden", !pCustom);
    document.getElementById("secondaryTexture").classList.toggle("hidden", !sCustom);
    document.getElementById("rgbInputArea").classList.toggle("hidden", !(pCustom || sCustom));

    refreshPreviews();
  };
  
  document.getElementById("primary").addEventListener("change", checkPaintCustom);
  document.getElementById("secondary").addEventListener("change", checkPaintCustom);

  // Color wheel ↔ RGB text sync
  const colorPicker = document.getElementById("colorPicker");
  const sharedRgbInput = document.getElementById("sharedRgb");
  if (colorPicker && sharedRgbInput) {
    colorPicker.addEventListener("input", () => {
      sharedRgbInput.value = colorPicker.value.toUpperCase();
      refreshPreviews();
    });
    sharedRgbInput.addEventListener("input", () => {
      const val = sharedRgbInput.value.trim();
      if (/^#?[0-9A-Fa-f]{6}$/.test(val)) {
        colorPicker.value = val.startsWith("#") ? val : "#" + val;
      }
    });
  }

  // Match Primary → Secondary (switches secondary to Custom RGB and copies the color)
  const matchBtn = document.getElementById("matchPrimaryBtn");
  if (matchBtn) {
    matchBtn.addEventListener("click", () => {
      const primarySel = document.getElementById("primary");
      const secondarySel = document.getElementById("secondary");
      const primaryVal = primarySel.value;
      if (!primaryVal) return;
      secondarySel.value = "Custom";
      secondarySel.dispatchEvent(new Event("change"));
      // If primary is a named color, grab its hex; if Custom, copy current RGB
      let hex = "";
      if (primaryVal === "Custom") {
        hex = sharedRgbInput.value.trim();
      } else {
        const opt = primarySel.options[primarySel.selectedIndex];
        hex = opt?.dataset?.hex || "";
      }
      if (hex) {
        if (!hex.startsWith("#") && /^[0-9A-Fa-f]{6}$/.test(hex)) hex = "#" + hex;
        sharedRgbInput.value = hex.toUpperCase();
        if (colorPicker) colorPicker.value = hex.startsWith("#") ? hex : "#" + hex;
        refreshPreviews();
      }
    });
  }

  // Color tiles open color wheel and switch slot to Custom RGB
  const tilePicker = document.getElementById("tileColorPicker");
  const tileTargets = {
    primaryPrev: "primary",
    secondaryPrev: "secondary",
    neonPrev: "neon",
    tireSmokePrev: "tireSmoke"
  };
  Object.entries(tileTargets).forEach(([tileId, selectId]) => {
    const tile = document.getElementById(tileId);
    if (!tile || !tilePicker) return;
    tile.style.cursor = "pointer";
    tile.title = "Click to pick color";
    tile.addEventListener("click", (e) => {
      const current = tile.style.backgroundColor;
      if (current && current !== "transparent") {
        const m = current.match(/rgb\((\d+),\s*(\d+),\s*(\d+)\)/);
        if (m) {
          const hex = "#" + [m[1],m[2],m[3]].map(n => parseInt(n).toString(16).padStart(2,"0")).join("");
          tilePicker.value = hex;
        }
      }
      // Position the picker over the tile so the native popup appears nearby
      const rect = tile.getBoundingClientRect();
      tilePicker.style.left = rect.left + "px";
      tilePicker.style.top = rect.top + "px";
      tilePicker.dataset.target = selectId;
      tilePicker.click();
    });
  });
  if (tilePicker) {
    tilePicker.addEventListener("input", () => {
      const target = tilePicker.dataset.target;
      if (!target) return;
      const hex = tilePicker.value.toUpperCase();
      const sel = document.getElementById(target);
      if (!sel) return;
      // Switch to Custom and set the value
      if (target === "primary" || target === "secondary") {
        sel.value = "Custom";
        sel.dispatchEvent(new Event("change"));
        if (sharedRgbInput) sharedRgbInput.value = hex;
        if (colorPicker) colorPicker.value = hex;
      } else if (target === "neon") {
        sel.value = "Custom RGB";
        sel.dispatchEvent(new Event("change"));
        const neonRgb = document.getElementById("neonRgb");
        if (neonRgb) neonRgb.value = hex;
      } else if (target === "tireSmoke") {
        sel.value = "Custom RGB";
        sel.dispatchEvent(new Event("change"));
        const smokeRgb = document.getElementById("tireSmokeCustom");
        if (smokeRgb) smokeRgb.value = hex;
      }
      refreshPreviews();
    });
  }

  document.getElementById("neon").addEventListener("change", () => {
    document.getElementById("neonRgbArea").classList.toggle("hidden", document.getElementById("neon").value !== "Custom RGB");
    refreshPreviews();
  });

  document.getElementById("tireSmoke").addEventListener("change", (e) => {
    document.getElementById("tireSmokeCustom").classList.toggle("hidden", e.target.value !== "Custom RGB");
    refreshPreviews();
  });

  ["sharedRgb", "neonRgb", "tireSmokeCustom"].forEach(id => document.getElementById(id).addEventListener("input", refreshPreviews));

  function getOpts(id) {
    return Array.from(document.getElementById(id).options)
      .map(o=>o.value)
      .filter(v => v && !v.startsWith("Custom") && v !== "None");
  }
  
  function pickRandom(arr) {
    return arr[Math.floor(Math.random() * arr.length)];
  }

  document.getElementById("btn-rand-vivid").addEventListener("click", () => {
    const prims = getOpts("primary").filter(v => {
      let hsl = getHslFromVal(v);
      return hsl.s > 0.4 && hsl.l > 0.15 && hsl.l < 0.85;
    });
    const pVal = pickRandom(prims) || getOpts("primary")[0];
    document.getElementById("primary").value = pVal;
    
    const pHsl = getHslFromVal(pVal);
    const secs = getOpts("secondary").filter(v => {
      let hsl = getHslFromVal(v);
      if(hsl.s < 0.4) return false;
      let diff = hueDistance(pHsl.h, hsl.h);
      return diff > 120 || diff < 45;
    });
    document.getElementById("secondary").value = pickRandom(secs) || pVal;
    
    checkPaintCustom();
    
    const pearls = getOpts("pearl").filter(v => getHslFromVal(v).s > 0.35);
    document.getElementById("pearl").value = pickRandom(pearls) || getOpts("pearl")[0];
    
    document.getElementById("interior").value = pickRandom(getOpts("interior")) || "";
    document.getElementById("rimColor").value = pickRandom(getOpts("rimColor")) || "";

    document.getElementById("headlights").value = pickRandom(getOpts("headlights").filter(h => h !== "White" && h !== "Pure White"));
    document.getElementById("neon").value = pickRandom(getOpts("neon"));
    document.getElementById("tireSmoke").value = pickRandom(["Match Headlights", "Match Neon", "Patriot"]);
    document.getElementById("windows").value = pickRandom(getOpts("windows")) || "";

    refreshPreviews();
  });

  document.getElementById("btn-rand-real").addEventListener("click", () => {
    const realPrims = getOpts("primary").filter(v => {
      let hsl = getHslFromVal(v);
      return hsl.s < 0.35 || hsl.l < 0.2 || hsl.l > 0.85;
    });
    const pVal = pickRandom(realPrims) || getOpts("primary")[0];
    document.getElementById("primary").value = pVal;
    
    const availableSecs = getOpts("secondary");
    document.getElementById("secondary").value = availableSecs.includes(pVal) ? pVal : (pickRandom(availableSecs) || pVal);
    
    checkPaintCustom();
    
    const realPearls = getOpts("pearl").filter(v => getHslFromVal(v).s < 0.2);
    document.getElementById("pearl").value = pickRandom(realPearls) || getOpts("pearl")[0];
    
    const realInts = getOpts("interior").filter(v => {
      let hsl = getHslFromVal(v);
      return hsl.s < 0.3 || hsl.l < 0.2 || hsl.l > 0.8;
    });
    document.getElementById("interior").value = pickRandom(realInts) || "";
    document.getElementById("rimColor").value = pickRandom(realInts) || "";

    document.getElementById("headlights").value = Math.random() > 0.5 ? "White" : "Pure White";
    document.getElementById("neon").value = "None";
    document.getElementById("tireSmoke").value = "Match Headlights"; 
    document.getElementById("windows").value = pickRandom(getOpts("windows")) || "";

    refreshPreviews();
  });

  document.getElementById("btn-random-wheels").addEventListener("click", () => {
    const wheelCats = getOpts("wheelCategory");
    document.getElementById("wheelCategory").value = pickRandom(wheelCats);
    document.getElementById("wheelCategory").dispatchEvent(new Event("change"));
    
    const rims = getOpts("rimStyle").filter(r => r !== "Stock");
    document.getElementById("rimStyle").value = pickRandom(rims) || "Stock";
    document.getElementById("rimStyle").dispatchEvent(new Event("change"));
  });

  document.getElementById("generate").addEventListener("click", () => {
    if (!validateStep(4)) return;

    const get = (id) => document.getElementById(id).value || "";
    const outPlate = get("plate").replace(/_/g, " "); 

    const detectFormat = (v) => {
      if (!v) return "RGB";
      const s = v.trim();
      if (s.startsWith("#") || /^[0-9A-Fa-f]{6}$/.test(s)) return "HEX";
      return "RGB";
    };
    const formatPaint = (val, isCustom, tex) => {
      if (isCustom) {
        const raw = get("sharedRgb");
        const fmt = detectFormat(raw);
        return `Custom ${fmt} (${raw}) over ${tex} Base`;
      }
      if (!val) return "N/A";
      const parts = val.split("|");
      return parts.length === 2 ? `${parts[0]} - ${parts[1]}` : val;
    };
    
    const formatColor = (val) => {
      if (!val) return "N/A";
      const parts = val.split("|");
      return parts.length === 2 ? `${parts[0]} - ${parts[1]}` : val;
    };

    const formatNeon = (val) => {
      if (val === "Custom RGB") {
        const raw = get("neonRgb");
        const fmt = detectFormat(raw);
        return `Custom ${fmt} (${raw})`;
      }
      if (val === "Match Headlights") {
        const base = lightColorMap[get("headlights")] || "255, 255, 255";
        const parts = base.split(',').map(n => parseInt(n.trim()));
        parts[0] = Math.max(0, parts[0] - 1);
        return parts.join(', ');
      }
      return val || "N/A";
    };

    const smokeSelect = get("tireSmoke");
    let finalSmoke = "N/A";
    if (smokeSelect === "Patriot") finalSmoke = "Patriot";
    else if (smokeSelect === "Custom RGB") {
      const raw = get("tireSmokeCustom");
      const fmt = detectFormat(raw);
      finalSmoke = `Custom ${fmt} (${raw})`;
    }
    else if (smokeSelect === "Match Headlights" || smokeSelect === "Match Neon") {
      let baseRgbStr = "255, 255, 255";
      if(smokeSelect === "Match Headlights") baseRgbStr = lightColorMap[get("headlights")] || "255, 255, 255";
      else {
        const ne = get("neon");
        baseRgbStr = ne === "Custom RGB" ? (parseColor(get("neonRgb")) || "255, 255, 255").replace('rgb(','').replace(')','') : (lightColorMap[ne] || "255, 255, 255");
      }
      const parts = baseRgbStr.split(',').map(n => parseInt(n.trim()));
      parts[0] = Math.max(0, parts[0] - 1);
      finalSmoke = parts.join(', ');
    }

    const isActivator = document.getElementById("activator").checked;
    const activatorOutput = isActivator ? `\nActivator Applied: Yes` : "";

    const pVal = get("primary");
    const sVal = get("secondary");

    const tireSelectVal = get("tires");
    const formattedTire = (tireSelectVal === "None" || tireSelectVal === "") ? "N/A" : tireSelectVal;

    const out = `=== DMO SPECIFICATION ===

[VEHICLE & PLATE]
Vehicle / Set: ${selectedVehicle ? selectedVehicle.display : get("vehicle")}
Plate Style: ${get("plateStyle")}
Plate Text: "${outPlate}"
Window Tint: ${get("windows")}
Livery: ${get("livery") || "None"}

[COLORS & PAINTS]
Primary: ${formatPaint(pVal, pVal === "Custom", get("primaryTexture"))}
Secondary: ${formatPaint(sVal, sVal === "Custom", get("secondaryTexture"))}
Pearlescent: ${formatColor(get("pearl"))}
Interior: ${formatColor(get("interior"))}
Rim Color: ${formatColor(get("rimColor"))}
Headlight Color: ${get("headlights")}
Neon Setup: ${formatNeon(get("neon"))}
Tire Smoke: ${finalSmoke}

[WHEELS]
Category: ${get("wheelCategory")}
Rim Style: ${get("rimStyle")}
Tire Design: ${formattedTire}${activatorOutput}`;
    
    document.getElementById("output").textContent = out;
    const builder = document.getElementById("dmo-builder");
    if (builder) builder.classList.add("hidden");
    document.getElementById("outputContainer").classList.remove("hidden");
    document.getElementById("outputContainer").scrollIntoView({ behavior: "smooth" });
  });

  document.getElementById("copy").addEventListener("click", () => {
    navigator.clipboard.writeText(document.getElementById("output").textContent).then(() => {
      const btn = document.getElementById("copy");
      const orig = btn.textContent;
      btn.textContent = "Copied!";
      setTimeout(() => (btn.textContent = orig), 1500);
    });
  });


  // ========== VEHICLE / SET SELECTOR ==========
  // vehicles is provided by define:vars from src/data/vehicles.json
  const setsList = ["Facility Set","Nightclub Set","Arena Set","Special Vehicle Set","Set 1 Set","Set 2 Set"];

  let selectedVehicle = null; // {display, value, file} or {display, value: setName, isSet: true}

  function updateNextButton() {
    const btn = document.getElementById("btn-next-1");
    const mode = document.querySelector('input[name="vehicleMode"]:checked')?.value;
    const valid = mode === "set" 
      ? !!document.getElementById("vehicleSet")?.value 
      : !!selectedVehicle;
    btn.disabled = !valid;
  }

  function renderVehicleDropdown(filter = "") {
    const dd = document.getElementById("vehicleDropdown");
    const q = filter.trim().toLowerCase();
    const matches = vehicles.filter(v => 
      v.display.toLowerCase().includes(q) || v.value.toLowerCase().includes(q)
    ).slice(0, 40);

    if (!q || matches.length === 0) {
      dd.classList.add("hidden");
      dd.innerHTML = "";
      return;
    }

    dd.innerHTML = matches.map(v => `
      <div class="vehicle-option px-3 py-2 text-sm text-white hover:bg-zinc-800 cursor-pointer border-b border-zinc-800/50 last:border-0"
           data-value="${v.value}" data-display="${v.display}" data-file="${v.file}">
        ${v.display}
      </div>
    `).join("");
    dd.classList.remove("hidden");
  }

  function selectVehicle(v) {
    selectedVehicle = { display: v.display, value: v.value, file: v.file, isSet: false };
    document.getElementById("vehicle").value = v.value;
    document.getElementById("vehicleSearch").value = v.display;
    document.getElementById("vehicleSelectedLabel").textContent = `Selected: ${v.display}`;
    const img = document.getElementById("vehiclePreviewImg");
    const wrap = document.getElementById("vehiclePreviewWrap");
    // Prefer external URL if available
    const urlEntry = (typeof vehicleUrls !== "undefined") ? vehicleUrls.find(u => u.display === v.display) : null;
    if (urlEntry && urlEntry.url) {
      img.src = urlEntry.url;
    } else if (v.file) {
      img.src = `/images/Vehicles/${v.file}`;
    }
    img.alt = v.display;
    wrap.classList.remove("hidden");
    document.getElementById("vehicleDropdown").classList.add("hidden");
    updateNextButton();
  }

  function clearVehicle() {
    selectedVehicle = null;
    document.getElementById("vehicle").value = "";
    document.getElementById("vehicleSelectedLabel").textContent = "";
    document.getElementById("vehiclePreviewWrap").classList.add("hidden");
    updateNextButton();
  }

  // Mode toggle
  document.querySelectorAll('input[name="vehicleMode"]').forEach(r => {
    r.addEventListener("change", () => {
      const isSet = r.value === "set";
      document.getElementById("vehicle-selector").classList.toggle("hidden", isSet);
      document.getElementById("set-selector").classList.toggle("hidden", !isSet);
      clearVehicle();
      if (isSet) document.getElementById("vehicleSet").value = "";
      updateNextButton();
    });
  });

  // Search input
  const searchEl = document.getElementById("vehicleSearch");
  searchEl.addEventListener("input", (e) => {
    clearVehicle();
    renderVehicleDropdown(e.target.value);
  });
  searchEl.addEventListener("focus", (e) => {
    if (e.target.value) renderVehicleDropdown(e.target.value);
  });

  // Click outside to close
  document.addEventListener("click", (e) => {
    if (!e.target.closest("#vehicle-selector")) {
      document.getElementById("vehicleDropdown").classList.add("hidden");
    }
  });

  // Option click
  document.getElementById("vehicleDropdown").addEventListener("click", (e) => {
    const opt = e.target.closest(".vehicle-option");
    if (!opt) return;
    selectVehicle({
      value: opt.dataset.value,
      display: opt.dataset.display,
      file: opt.dataset.file
    });
  });

  // Set change
  document.getElementById("vehicleSet").addEventListener("change", (e) => {
    const val = e.target.value;
    if (val) {
      selectedVehicle = { display: val, value: val, isSet: true };
      document.getElementById("vehicle").value = val;
    } else {
      clearVehicle();
    }
    updateNextButton();
  });

  // Prevent free-text next if not selected
  document.getElementById("btn-next-1").addEventListener("click", (e) => {
    if (document.getElementById("btn-next-1").disabled) {
      e.preventDefault();
      return;
    }
  });

  updateNextButton();
  // ========== END VEHICLE SELECTOR ==========


    populatePrimary(); populateSecondary();
  populateUnselectedOnly("pearl", "pearl"); populateUnselectedOnly("interior", "interior"); populateUnselectedOnly("rimColor", "rim");
  updatePlatePreview(); 
</script>



