---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Game Maps">
  <div class="page-shell">
    <header class="page-head">
      <h1 class="page-title">
        <span class="text-white">Game</span> <span class="text-gold">Maps</span>
      </h1>
      <p class="page-kicker">Interactive Maps for GTAO • RDO • Fallout 76</p>
    </header>

    <p class="text-zinc-400 text-sm md:text-base leading-relaxed mb-10 max-w-3xl">
      Quick access to the best community interactive maps we use for GTA Online, Red Dead Online, and Fallout 76. 
      Open them in a new tab while you play — perfect for collectibles, locations, routes, and planning.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- GTA Online -->
      <a href="https://gtaweb.eu/gtao-map/ls/" target="_blank" rel="noopener noreferrer" class="group block bg-zinc-900/40 border border-zinc-800 rounded-2xl p-6 hover:border-gold/60 hover:bg-zinc-900/60 transition-all duration-300">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-10 h-10 rounded-lg bg-gold/10 border border-gold/20 flex items-center justify-center text-gold font-bold text-lg">GTA</div>
          <h3 class="text-lg font-header text-white uppercase tracking-tight group-hover:text-gold transition-colors">GTA Online Map</h3>
        </div>
        <p class="text-sm text-zinc-400 leading-relaxed">
          Full interactive Los Santos + Cayo Perico map. Collectibles, businesses, events, vehicles, routes, custom markers, and more. Updated regularly by the community.
        </p>
        <span class="inline-block mt-4 text-[10px] uppercase tracking-wider text-gold font-black">Open GTAWeb Map →</span>
      </a>

      <!-- RDO Collectors -->
      <a href="https://jeanropke.github.io/RDR2CollectorsMap/" target="_blank" rel="noopener noreferrer" class="group block bg-zinc-900/40 border border-zinc-800 rounded-2xl p-6 hover:border-gold/60 hover:bg-zinc-900/60 transition-all duration-300">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-10 h-10 rounded-lg bg-gold/10 border border-gold/20 flex items-center justify-center text-gold font-bold text-lg">RDO</div>
          <h3 class="text-lg font-header text-white uppercase tracking-tight group-hover:text-gold transition-colors">RDO Collectors Map</h3>
        </div>
        <p class="text-sm text-zinc-400 leading-relaxed">
          Jeanropke’s legendary Red Dead Online Collectors map. Cycles, Madam Nazar sets, jewelry, flowers, fossils, coins, and every collectible with filters and progress tracking.
        </p>
        <span class="inline-block mt-4 text-[10px] uppercase tracking-wider text-gold font-black">Open Collectors Map →</span>
      </a>

      <!-- Fallout 76 -->
      <a href="https://fo76map.com/" target="_blank" rel="noopener noreferrer" class="group block bg-zinc-900/40 border border-zinc-800 rounded-2xl p-6 hover:border-gold/60 hover:bg-zinc-900/60 transition-all duration-300">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-10 h-10 rounded-lg bg-gold/10 border border-gold/20 flex items-center justify-center text-gold font-bold text-lg">FO76</div>
          <h3 class="text-lg font-header text-white uppercase tracking-tight group-hover:text-gold transition-colors">Fallout 76 Map</h3>
        </div>
        <p class="text-sm text-zinc-400 leading-relaxed">
          Interactive Appalachia map with locations, resources, power armor, workshops, holotapes, bobbleheads, and progress tracking. Great for farming and exploration.
        </p>
        <span class="inline-block mt-4 text-[10px] uppercase tracking-wider text-gold font-black">Open FO76 Map →</span>
      </a>
    </div>

    <div class="mt-12 bg-zinc-900/40 border border-zinc-800 rounded-2xl p-6">
      <h2 class="text-xl font-header uppercase tracking-tight text-gold mb-3">Bonus RDO Map</h2>
      <p class="text-sm text-zinc-400 leading-relaxed mb-4">
        Looking for more than just collectors? Jeanropke also maintains a broader Red Dead Online map covering roles, events, animals, and more.
      </p>
      <a href="https://jeanropke.github.io/RDOMap/" target="_blank" rel="noopener noreferrer" class="inline-block text-[10px] uppercase tracking-wider text-gold font-black hover:text-gold-bright transition-colors">
        Open Full RDO Map →
      </a>
    </div>
  </div>
</MainLayout>