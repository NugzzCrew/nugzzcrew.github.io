---
import MainLayout from '../layouts/MainLayout.astro';
import { getSession } from 'auth-astro/server';

const session = await getSession(Astro.request);
---

<MainLayout title="Account">
  <div class="page-shell">
    <header class="page-head">
      <h1 class="page-title">
        <span class="text-white">Official</span> <span class="text-gold">Nugzz Crew</span>
      </h1>
      <p class="page-kicker">Account</p>
    </header>

    <div class="bg-zinc-900/40 border border-zinc-800 rounded-2xl p-6 border-t-4 border-t-gold max-w-lg">
      {session?.user ? (
        <div class="space-y-4">
          <div class="flex items-center gap-4">
            {session.user.image && (
              <img src={session.user.image} alt="" class="w-12 h-12 rounded-full" />
            )}
            <div>
              <p class="text-white font-medium">{session.user.name}</p>
              <p class="text-zinc-400 text-sm">{session.user.email}</p>
            </div>
          </div>
          <button
            id="signout"
            class="px-4 py-2 bg-zinc-800 border border-zinc-700 rounded-lg text-zinc-300 hover:border-gold hover:text-gold transition-colors text-sm uppercase tracking-widest"
          >
            Sign Out
          </button>
        </div>
      ) : (
        <div class="space-y-3">
          <p class="text-zinc-300 text-sm">Sign in to link your accounts for DMO tickets and live stream features.</p>
          <button
            id="discord"
            class="w-full px-4 py-3 bg-[#5865F2] hover:bg-[#4752C4] text-white rounded-lg font-medium transition-colors"
          >
            Continue with Discord
          </button>
          <button
            id="google"
            class="w-full px-4 py-3 bg-white hover:bg-zinc-100 text-black rounded-lg font-medium transition-colors"
          >
            Continue with Google
          </button>
        </div>
      )}
    </div>
  </div>
</MainLayout>

<script>
  import { signIn, signOut } from 'auth-astro/client';

  document.getElementById('discord')?.addEventListener('click', () => signIn('discord'));
  document.getElementById('google')?.addEventListener('click', () => signIn('google'));
  document.getElementById('signout')?.addEventListener('click', () => signOut());
</script>