---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Emblem Creator">
  <div class="max-w-[1400px] mx-auto py-8 px-4 md:px-6">
    
<section class="mb-8">
  <h1 class="text-3xl md:text-4xl font-black italic uppercase leading-none text-white tracking-tighter drop-shadow-md">
    Emblem <span class="text-gold">Creator</span>
  </h1>
  <p class="text-zinc-400 font-bold uppercase tracking-widest text-[10px] mt-1 italic">
    Image and Text to Emblem Code
  </p>
</section>

<div class="flex flex-col lg:flex-row gap-6">
  
  <!-- Left Column: Settings -->
  <div class="w-full lg:w-80 flex-shrink-0 space-y-6">
    
    <!-- Source Module -->
    <div class="bg-zinc-900/60 backdrop-blur-md border border-zinc-700/50 rounded-2xl p-5 shadow-lg">
      <h2 class="text-[10px] text-zinc-500 font-black uppercase tracking-widest mb-4">Source</h2>
      
      <div class="flex bg-black rounded-xl p-1 border border-zinc-800 mb-4">
        <button class="flex-1 bg-zinc-800 text-gold text-xs font-bold py-2 rounded-lg uppercase tracking-tight shadow-sm">Image</button>
        <button class="flex-1 text-zinc-400 hover:text-white text-xs font-bold py-2 rounded-lg uppercase tracking-tight transition-colors">Text</button>
      </div>

      <div class="relative border border-dashed border-zinc-600 rounded-xl p-3 hover:border-gold/50 transition-colors bg-black/40 group overflow-hidden">
        <input type="file" id="imageInput" accept="image/*" class="opacity-0 absolute inset-0 w-full h-full cursor-pointer z-20" />
        
        <div class="flex items-center gap-3 relative z-10 pointer-events-none">
          <div class="w-10 h-10 rounded-full bg-zinc-800 border border-zinc-700 flex items-center justify-center shrink-0" id="sourceThumbContainer">
            <i data-lucide="image" class="w-4 h-4 text-zinc-400" id="sourceIcon"></i>
            <img id="sourceThumb" src="" class="hidden w-full h-full object-cover rounded-full" />
          </div>
          <div class="flex flex-col overflow-hidden">
            <span class="text-white font-mono text-xs font-bold truncate" id="uploadText">Select Image...</span>
            <span class="text-zinc-500 text-[9px] uppercase tracking-wider mt-0.5" id="uploadSubtext">Click to browse</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Settings Module -->
    <div class="bg-zinc-900/60 backdrop-blur-md border border-zinc-700/50 rounded-2xl p-5 shadow-lg space-y-5">
      <div class="flex justify-between items-center">
        <h2 class="text-[10px] text-zinc-500 font-black uppercase tracking-widest">Settings</h2>
      </div>

      <!-- Resolution -->
      <div class="space-y-2">
        <label class="text-white text-xs font-bold flex items-center gap-1.5">
          Resolution <i data-lucide="info" class="w-3 h-3 text-zinc-500"></i>
        </label>
        <div class="flex bg-black rounded-lg p-1 border border-zinc-800" data-setting="resolution">
          <button data-value="auto" class="flex-1 text-zinc-400 hover:text-white text-[10px] font-bold py-1.5 rounded-md uppercase">Auto</button>
          <button data-value="128" class="flex-1 text-zinc-400 hover:text-white text-[10px] font-bold py-1.5 rounded-md uppercase">128</button>
          <button data-value="256" class="flex-1 bg-zinc-800 text-gold text-[10px] font-bold py-1.5 rounded-md uppercase">256</button>
          <button data-value="512" class="flex-1 text-zinc-400 hover:text-white text-[10px] font-bold py-1.5 rounded-md uppercase">512</button>
        </div>
      </div>

      <!-- Method -->
      <div class="space-y-2">
        <label class="text-white text-xs font-bold flex items-center gap-1.5">
          Method <i data-lucide="info" class="w-3 h-3 text-zinc-500"></i>
        </label>
        <div class="flex bg-black rounded-lg p-1 border border-zinc-800" data-setting="method">
          <button data-value="auto" class="flex-1 bg-zinc-800 text-gold text-[10px] font-bold py-1.5 rounded-md uppercase">Auto</button>
          <button data-value="rows" class="flex-1 text-zinc-400 hover:text-white text-[10px] font-bold py-1.5 rounded-md uppercase">Rows</button>
          <button data-value="cols" class="flex-1 text-zinc-400 hover:text-white text-[10px] font-bold py-1.5 rounded-md uppercase">Cols</button>
        </div>
      </div>

      <!-- Detail -->
      <div class="space-y-2">
        <label class="text-white text-xs font-bold flex items-center gap-1.5">
          Detail <i data-lucide="info" class="w-3 h-3 text-zinc-500"></i>
        </label>
        <div class="flex bg-black rounded-lg p-1 border border-zinc-800" data-setting="detail">
          <button data-value="auto" class="flex-1 bg-zinc-800 text-gold text-[10px] font-bold py-1.5 rounded-md uppercase">Auto</button>
          <button data-value="low" class="flex-1 text-zinc-400 hover:text-white text-[10px] font-bold py-1.5 rounded-md uppercase">Low</button>
          <button data-value="med" class="flex-1 text-zinc-400 hover:text-white text-[10px] font-bold py-1.5 rounded-md uppercase">Med</button>
          <button data-value="high" class="flex-1 text-zinc-400 hover:text-white text-[10px] font-bold py-1.5 rounded-md uppercase">High</button>
        </div>
      </div>

      <!-- Toggles -->
      <div class="space-y-3 pt-3 border-t border-zinc-800">
        <label class="flex items-center justify-between cursor-pointer">
          <span class="text-white text-xs font-bold flex items-center gap-1.5">
            Auto-optimize <i data-lucide="info" class="w-3 h-3 text-zinc-500"></i>
          </span>
          <div class="relative">
            <input type="checkbox" id="autoOptimize" class="sr-only peer" checked>
            <div class="w-8 h-4 bg-zinc-700 rounded-full peer peer-checked:after:translate-x-full peer-checked:bg-gold after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-3 after:w-3 after:transition-all"></div>
          </div>
        </label>

        <label class="flex items-center justify-between cursor-pointer">
          <span class="text-white text-xs font-bold flex items-center gap-1.5">
            Pixelization <i data-lucide="info" class="w-3 h-3 text-zinc-500"></i>
          </span>
          <div class="relative">
            <input type="checkbox" id="pixelization" class="sr-only peer">
            <div class="w-8 h-4 bg-zinc-700 rounded-full peer peer-checked:after:translate-x-full peer-checked:bg-gold after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-3 after:w-3 after:transition-all"></div>
          </div>
        </label>

        <label class="flex items-center justify-between cursor-pointer">
          <span class="text-white text-xs font-bold flex items-center gap-1.5">
            Crop empty edges <i data-lucide="info" class="w-3 h-3 text-zinc-500"></i>
          </span>
          <div class="relative">
            <input type="checkbox" id="cropEdges" class="sr-only peer" checked>
            <div class="w-8 h-4 bg-zinc-700 rounded-full peer peer-checked:after:translate-x-full peer-checked:bg-gold after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-3 after:w-3 after:transition-all"></div>
          </div>
        </label>
      </div>

      <button id="resetBtn" class="w-full bg-zinc-800 hover:bg-zinc-700 text-white text-[10px] font-black uppercase tracking-widest py-3 rounded-xl transition-colors mt-2">
        Reset to defaults
      </button>
    </div>
  </div>

  <!-- Center Column: Preview Grid -->
  <div class="flex-grow flex flex-col min-h-[500px]">
    <div class="bg-black border border-zinc-800 rounded-2xl flex-grow relative overflow-hidden flex items-center justify-center p-8 shadow-inner" style="background-image: linear-gradient(45deg, #18181b 25%, transparent 25%), linear-gradient(-45deg, #18181b 25%, transparent 25%), linear-gradient(45deg, transparent 75%, #18181b 75%), linear-gradient(-45deg, transparent 75%, #18181b 75%); background-size: 20px 20px; background-position: 0 0, 0 10px, 10px -10px, -10px 0px;">
      
      <canvas id="mainPreview" class="hidden max-w-full max-h-full object-contain filter drop-shadow-2xl scale-95 transition-transform duration-500"></canvas>
      
      <div id="previewPlaceholder" class="text-zinc-600 flex flex-col items-center gap-4">
        <i data-lucide="image-plus" class="w-16 h-16 opacity-50"></i>
        <span class="text-xs font-bold uppercase tracking-widest opacity-50">Upload an image to preview</span>
      </div>

      <div id="processing" class="hidden absolute inset-0 bg-black/60 flex items-center justify-center">
        <span class="text-gold text-xs font-bold uppercase tracking-widest">Generating...</span>
      </div>
    </div>
  </div>

  <!-- Right Column: Output -->
  <div class="w-full lg:w-80 flex-shrink-0 flex flex-col gap-6">
    
    <!-- Output Module -->
    <div class="bg-zinc-900/60 backdrop-blur-md border border-zinc-700/50 rounded-2xl p-5 shadow-lg flex flex-col flex-grow">
      <h2 class="text-[10px] text-zinc-500 font-black uppercase tracking-widest mb-4">Output</h2>
      
      <div class="space-y-1 mb-4 hidden" id="outputStats">
        <div class="flex justify-between text-[10px] font-mono font-bold">
          <span class="text-zinc-400">SIZE</span>
          <span class="text-white"><span class="text-gold" id="sizeValue">0</span> / 1,600,000</span>
        </div>
        <div class="w-full bg-zinc-800 h-1.5 rounded-full overflow-hidden">
          <div id="sizeBar" class="bg-green-500 h-full w-[0%] shadow-[0_0_10px_rgba(34,197,94,0.5)]"></div>
        </div>
      </div>

      <div class="bg-black/50 border border-green-500/30 rounded-xl p-4 mb-4 hidden" id="readyStatus">
        <div class="flex items-center gap-2 mb-1">
          <div class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></div>
          <span class="text-green-500 text-xs font-black uppercase tracking-tight">Ready to copy</span>
        </div>
        <p class="text-zinc-400 text-[10px] leading-tight">Copy the code and paste it into the editor console.</p>
      </div>

      <button id="copyBtn" disabled class="w-full bg-white hover:bg-gray-200 text-black disabled:bg-zinc-800 disabled:text-zinc-600 font-black uppercase text-sm py-4 rounded-xl transition-colors tracking-tighter mb-4 shadow-md flex items-center justify-center gap-2">
        <i data-lucide="copy" class="w-4 h-4"></i>
        <span>Copy Code</span>
      </button>

      <details class="group border-t border-zinc-800 pt-3 flex-grow flex flex-col" open>
        <summary class="text-[10px] text-zinc-400 font-bold uppercase tracking-widest cursor-pointer flex items-center gap-2 hover:text-gold transition-colors list-none">
          <i data-lucide="chevron-down" class="w-3 h-3 group-open:rotate-180 transition-transform"></i>
          Show raw code
        </summary>
        <div class="pt-3 flex-grow flex flex-col min-h-0">
          <textarea id="outputCode" readonly class="w-full flex-grow min-h-[180px] bg-black border border-zinc-800 rounded-xl p-3 text-zinc-300 font-mono text-[9px] focus:outline-none focus:border-gold/50 resize-none" placeholder="// Generate an emblem to see the console code here"></textarea>
        </div>
      </details>
    </div>

    <!-- Mini Previews -->
    <div class="bg-zinc-900/60 backdrop-blur-md border border-zinc-700/50 rounded-2xl p-5 shadow-lg">
      <h2 class="text-[10px] text-zinc-500 font-black uppercase tracking-widest mb-6">Preview Sizes</h2>
      
      <div class="flex items-end justify-center gap-8 h-32 relative pb-6">
        <div class="flex flex-col items-center gap-2">
          <div class="w-24 h-24 border border-zinc-700 rounded-full flex items-center justify-center overflow-hidden bg-black relative">
            <canvas class="mini-preview hidden w-full h-full"></canvas>
          </div>
          <span class="text-[9px] text-zinc-500 font-mono absolute bottom-0">256</span>
        </div>

        <div class="flex flex-col items-center gap-2">
          <div class="w-16 h-16 border border-zinc-700 rounded-full flex items-center justify-center overflow-hidden bg-black relative">
            <canvas class="mini-preview hidden w-full h-full"></canvas>
          </div>
          <span class="text-[9px] text-zinc-500 font-mono absolute bottom-0">128</span>
        </div>

        <div class="flex flex-col items-center gap-2">
          <div class="w-10 h-10 border border-zinc-700 rounded-full flex items-center justify-center overflow-hidden bg-black relative">
            <canvas class="mini-preview hidden w-full h-full"></canvas>
          </div>
          <span class="text-[9px] text-zinc-500 font-mono absolute bottom-0">64</span>
        </div>
      </div>
    </div>

  </div>

</div>

  <!-- How to Apply on Social Club -->
  <div class="mt-8 w-full">
    <div class="bg-zinc-900/60 backdrop-blur-md border border-zinc-700/50 rounded-2xl p-5 shadow-lg">
      <h2 class="text-[10px] text-zinc-500 font-black uppercase tracking-widest mb-4">How to Apply on Social Club</h2>

      <!-- Tutorial Video -->
      <div class="mb-6 aspect-video w-full max-w-3xl mx-auto rounded-xl overflow-hidden border border-zinc-800 bg-black">
        <iframe
          class="w-full h-full"
          src="https://www.youtube.com/embed/BI_bY-7ZICs"
          title="Emblem Editor Tutorial"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>

      <ol class="space-y-2.5 text-zinc-300 text-[13px] leading-snug">
        <li class="flex gap-3">
          <span class="text-gold font-mono text-xs font-bold shrink-0 mt-0.5">1.</span>
          <span>Navigate to the <a href="https://socialclub.rockstargames.com" target="_blank" rel="noopener" class="text-gold hover:underline">Rockstar Social Club</a>, log in, and go to your Crew Emblems page. Click <strong class="text-white">Create a New Emblem</strong>.</span>
        </li>
        <li class="flex gap-3">
          <span class="text-gold font-mono text-xs font-bold shrink-0 mt-0.5">2.</span>
          <span>Open Developer Tools: press <kbd class="px-1.5 py-0.5 bg-zinc-800 border border-zinc-700 rounded text-[10px] font-mono">F12</kbd> (or <kbd class="px-1.5 py-0.5 bg-zinc-800 border border-zinc-700 rounded text-[10px] font-mono">Ctrl+Shift+J</kbd>).</span>
        </li>
        <li class="flex gap-3">
          <span class="text-gold font-mono text-xs font-bold shrink-0 mt-0.5">3.</span>
          <span>Click the <strong class="text-white">Console</strong> tab. Look for the blinking cursor at the bottom.</span>
        </li>
        <li class="flex gap-3">
          <span class="text-gold font-mono text-xs font-bold shrink-0 mt-0.5">4.</span>
          <span>If you see a paste warning, type <code class="px-1.5 py-0.5 bg-zinc-800 border border-zinc-700 rounded text-[10px] font-mono">allow pasting</code> and press Enter.</span>
        </li>
        <li class="flex gap-3">
          <span class="text-gold font-mono text-xs font-bold shrink-0 mt-0.5">5.</span>
          <span>Right-click at the cursor → <strong class="text-white">Paste</strong> (or <kbd class="px-1.5 py-0.5 bg-zinc-800 border border-zinc-700 rounded text-[10px] font-mono">Ctrl+V</kbd>), then press <kbd class="px-1.5 py-0.5 bg-zinc-800 border border-zinc-700 rounded text-[10px] font-mono">Enter</kbd>.</span>
        </li>
        <li class="flex gap-3">
          <span class="text-gold font-mono text-xs font-bold shrink-0 mt-0.5">6.</span>
          <span>Close Developer Tools (<kbd class="px-1.5 py-0.5 bg-zinc-800 border border-zinc-700 rounded text-[10px] font-mono">F12</kbd>), click <strong class="text-white">Save</strong>, then <strong class="text-white">Publish</strong>.</span>
        </li>
      </ol>
    </div>
  </div>

</div>
</MainLayout>

